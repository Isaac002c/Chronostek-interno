// Telun — Sistema Interno (CRM/ERP modular)
// Schema Prisma. Money fields use Float for clean Server->Client serialization
// (documented MVP trade-off vs Decimal).
//
// Fase "Gestão por Centro de Custo": CostCenter expandido, Budget/BudgetLine,
// ApprovalRequest, jurídico completo (LegalDocument/Demand/Risk) e costCenterId
// em todas as entidades operacionais. Mudanças aditivas (nada removido).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

