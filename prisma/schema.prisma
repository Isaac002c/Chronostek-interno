// ─────────────────────────────── CORE ───────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(VIEWER)
  status       UserStatus @default(ATIVO)
  costCenterId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  costCenter             CostCenter?       @relation("UserCostCenter", fields: [costCenterId], references: [id])
  costCentersResponsible CostCenter[]      @relation("CostCenterResponsible")
  leads                  Lead[]            @relation("LeadResponsible")
  leadInteractions       LeadInteraction[]
  clients                Client[]          @relation("ClientResponsible")
  projects               Project[]         @relation("ProjectResponsible")
  timesheets             Timesheet[]
  legalContracts         LegalContract[]   @relation("LegalResponsible")
  legalDeadlines         LegalDeadline[]   @relation("DeadlineResponsible")
  legalDocuments         LegalDocument[]   @relation("LegalDocResponsible")
  legalDemands           LegalDemand[]     @relation("LegalDemandResponsible")
  legalRisks             LegalRisk[]       @relation("LegalRiskResponsible")
  goals                  Goal[]            @relation("GoalResponsible")
  goalAssignments        GoalAssignee[]    @relation("GoalAssigneeUser")
  planningPeriodsCreated PlanningPeriod[]  @relation("PlanningPeriodCreatedBy")
  tasksAssigned          Task[]            @relation("TaskAssignee")
  tasksCreated           Task[]            @relation("TaskCreatedBy")
  budgetsApproved        Budget[]          @relation("BudgetApprover")
  approvalsRequested     ApprovalRequest[] @relation("ApprovalRequester")
  approvalsResponded     ApprovalRequest[] @relation("ApprovalApprover")
  auditLogs              AuditLog[]

  financialCreated     FinancialEntry[]       @relation("FinancialCreatedBy")
  financialResponsible FinancialEntry[]       @relation("FinancialResponsible")
  financialApproved    FinancialEntry[]       @relation("FinancialApprovedBy")
  recurringCreated     RecurringEntry[]       @relation("RecurringCreatedBy")
  closingsClosed       MonthlyClosing[]       @relation("ClosingClosedBy")
  closingsReopened     MonthlyClosing[]       @relation("ClosingReopenedBy")
  attachmentsUploaded  Attachment[]           @relation("AttachmentUploadedBy")
  reconciliations      Reconciliation[]       @relation("ReconciledBy")
  orgSettingsUpdated   OrganizationSettings[] @relation("OrgSettingsUpdatedBy")

  @@index([role])
  @@index([status])
}

model CostCenter {
  id                   String         @id @default(cuid())
  code                 Int            @unique // 1000, 2000, 3000, 4000, 5000
  name                 String
  description          String?
  type                 CostCenterType @default(OUTRO)
  responsibleUserId    String?
  parentCostCenterId   String?
  active               Boolean        @default(true)
  monthlyBudgetDefault Float?
  annualBudgetDefault  Float?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  responsibleUser     User?               @relation("CostCenterResponsible", fields: [responsibleUserId], references: [id])
  parent              CostCenter?         @relation("CostCenterHierarchy", fields: [parentCostCenterId], references: [id])
  children            CostCenter[]        @relation("CostCenterHierarchy")
  users               User[]              @relation("UserCostCenter")
  contracts           Contract[]
  financialEntries    FinancialEntry[]
  financialCategories FinancialCategory[] @relation("CategoryCostCenter")
  projects            Project[]
  campaigns           MarketingCampaign[]
  proposals           Proposal[]
  goals               Goal[]
  goalIndicators      GoalIndicator[]     @relation("IndicatorCostCenter")
  tasks               Task[]
  budgets             Budget[]
  budgetLines         BudgetLine[]
  legalContracts      LegalContract[]
  legalDeadlines      LegalDeadline[]
  legalDocuments      LegalDocument[]
  legalDemands        LegalDemand[]
  legalRisks          LegalRisk[]
  recurringEntries    RecurringEntry[]
  approvalRules       ApprovalRule[]      @relation("ApprovalRuleCostCenter")

  @@index([active])
  @@index([type])
}

model FinancialCategory {
  id           String       @id @default(cuid())
  code         String       @unique // "1.1", "2.3"...
  name         String
  type         CategoryType
  costCenterId String?
  parentId     String? // plano de contas hierárquico (grupo → subgrupo → conta)
  dreGroup     DreGroup? // mapeia a conta para a linha da DRE gerencial
  order        Int          @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  costCenter       CostCenter?         @relation("CategoryCostCenter", fields: [costCenterId], references: [id])
  parent           FinancialCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children         FinancialCategory[] @relation("CategoryHierarchy")
  financialEntries FinancialEntry[]
  contracts        Contract[]
  budgetLines      BudgetLine[]
  recurringEntries RecurringEntry[]
  approvalRules    ApprovalRule[]      @relation("ApprovalRuleCategory")

  @@index([type])
  @@index([parentId])
  @@index([dreGroup])
}

// ─────────────────────────────── ORÇAMENTO ───────────────────────────────

model Budget {
  id             String           @id @default(cuid())
  costCenterId   String
  periodType     BudgetPeriodType
  month          Int?
  quarter        Int?
  year           Int
  plannedRevenue Float            @default(0)
  plannedExpense Float            @default(0)
  plannedProfit  Float            @default(0)
  status         BudgetStatus     @default(RASCUNHO)
  approvedById   String?
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  costCenter CostCenter   @relation(fields: [costCenterId], references: [id])
  approvedBy User?        @relation("BudgetApprover", fields: [approvedById], references: [id])
  lines      BudgetLine[]

  @@index([costCenterId])
  @@index([year, month])
  @@index([status])
}

model BudgetLine {
  id                  String        @id @default(cuid())
  budgetId            String
  costCenterId        String
  financialCategoryId String?
  type                FinancialType
  plannedAmount       Float         @default(0)
  description         String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  budget     Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  costCenter CostCenter         @relation(fields: [costCenterId], references: [id])
  category   FinancialCategory? @relation(fields: [financialCategoryId], references: [id])

  @@index([budgetId])
  @@index([costCenterId])
}

// ─────────────────────────────── APROVAÇÕES ───────────────────────────────

model ApprovalRequest {
  id            String         @id @default(cuid())
  type          ApprovalType
  requestedById String?
  approvedById  String?
  status        ApprovalStatus @default(PENDENTE)
  entityType    String
  entityId      String
  amount        Float?
  reason        String?
  responseNote  String?
  createdAt     DateTime       @default(now())
  respondedAt   DateTime?

  requestedBy User? @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approvedBy  User? @relation("ApprovalApprover", fields: [approvedById], references: [id])

  @@index([status])
  @@index([type])
  @@index([entityType, entityId])
}

// ─────────────────────────────── CRM / LEADS ───────────────────────────────

model Lead {
  id                String     @id @default(cuid())
  name              String
  company           String?
  phone             String?
  email             String?
  origin            LeadOrigin @default(OUTRO)
  channel           String?
  campaignId        String?
  responsibleId     String?
  costCenterId      String?
  status            LeadStatus @default(NOVO)
  estimatedValue    Float?
  probability       Int?
  expectedCloseDate DateTime?
  notes             String?
  lossReason        String?
  tags              String[]   @default([])
  convertedClientId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  campaign        MarketingCampaign? @relation(fields: [campaignId], references: [id])
  responsible     User?              @relation("LeadResponsible", fields: [responsibleId], references: [id])
  convertedClient Client?            @relation("LeadConverted", fields: [convertedClientId], references: [id])
  interactions    LeadInteraction[]
  tasks           Task[]             @relation("LeadTasks")

  @@index([status])
  @@index([origin])
  @@index([responsibleId])
  @@index([createdAt])
}

model LeadInteraction {
  id        String              @id @default(cuid())
  leadId    String
  userId    String?
  type      LeadInteractionType @default(NOTA)
  content   String
  createdAt DateTime            @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
}

// ─────────────────────────────── COMERCIAL ───────────────────────────────

model Client {
  id                    String       @id @default(cuid())
  name                  String
  tradeName             String?
  document              String?
  email                 String?
  phone                 String?
  internalResponsibleId String?
  status                ClientStatus @default(PROSPECT)
  origin                LeadOrigin?
  healthScore           Int          @default(50)
  notes                 String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  internalResponsible User?            @relation("ClientResponsible", fields: [internalResponsibleId], references: [id])
  contracts           Contract[]
  proposals           Proposal[]
  projects            Project[]
  financialEntries    FinancialEntry[]
  convertedLeads      Lead[]           @relation("LeadConverted")
  legalContracts      LegalContract[]
  legalDocuments      LegalDocument[]
  legalDemands        LegalDemand[]
  recurringEntries    RecurringEntry[]
  tasks               Task[]           @relation("ClientTasks")

  @@index([status])
  @@index([internalResponsibleId])
}

model Proposal {
  id           String         @id @default(cuid())
  clientId     String?
  leadId       String?
  costCenterId String?
  title        String
  value        Float          @default(0)
  status       ProposalStatus @default(RASCUNHO)
  probability  Int?
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  client     Client?     @relation(fields: [clientId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])

  @@index([status])
  @@index([clientId])
}

model Contract {
  id           String         @id @default(cuid())
  clientId     String
  title        String
  type         ContractType
  totalValue   Float?
  monthlyValue Float?
  startDate    DateTime?
  endDate      DateTime?
  status       ContractStatus @default(ATIVO)
  costCenterId String?
  categoryId   String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  client           Client             @relation(fields: [clientId], references: [id])
  costCenter       CostCenter?        @relation(fields: [costCenterId], references: [id])
  category         FinancialCategory? @relation(fields: [categoryId], references: [id])
  financialEntries FinancialEntry[]
  projects         Project[]
  recurringEntries RecurringEntry[]
  tasks            Task[]             @relation("ContractTasks")

  @@index([status])
  @@index([type])
  @@index([clientId])
}

// ─────────────────────────────── FINANCEIRO ───────────────────────────────

model FinancialEntry {
  id                String          @id @default(cuid())
  description       String
  type              FinancialType
  value             Float           @default(0) // valor previsto/principal
  paidValue         Float? // valor realizado (pago/recebido, inclui parciais)
  dueDate           DateTime?
  paymentDate       DateTime?
  competenceMonth   Int // 1-12
  competenceYear    Int
  status            FinancialStatus @default(PENDENTE)
  costCenterId      String?
  categoryId        String?
  clientId          String?
  contractId        String?
  projectId         String?
  campaignId        String?
  supplierId        String?
  bankAccountId     String?
  recurringEntryId  String?
  recurring         Boolean         @default(false)
  installments      Int?
  installmentNumber Int?
  paymentMethod     PaymentMethod?
  createdById       String?
  responsibleId     String?
  approvedById      String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  costCenter     CostCenter?        @relation(fields: [costCenterId], references: [id])
  category       FinancialCategory? @relation(fields: [categoryId], references: [id])
  client         Client?            @relation(fields: [clientId], references: [id])
  contract       Contract?          @relation(fields: [contractId], references: [id])
  project        Project?           @relation(fields: [projectId], references: [id])
  campaign       MarketingCampaign? @relation(fields: [campaignId], references: [id])
  supplier       Supplier?          @relation(fields: [supplierId], references: [id])
  bankAccount    BankAccount?       @relation(fields: [bankAccountId], references: [id])
  recurringEntry RecurringEntry?    @relation(fields: [recurringEntryId], references: [id])
  createdBy      User?              @relation("FinancialCreatedBy", fields: [createdById], references: [id])
  responsible    User?              @relation("FinancialResponsible", fields: [responsibleId], references: [id])
  approvedBy     User?              @relation("FinancialApprovedBy", fields: [approvedById], references: [id])
  tasks          Task[]             @relation("FinancialTasks")

  @@index([type])
  @@index([status])
  @@index([competenceYear, competenceMonth])
  @@index([dueDate])
  @@index([costCenterId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([bankAccountId])
  @@index([recurringEntryId])
}

// ─────────────────────────────── INOVAÇÃO / TI ───────────────────────────────

model Project {
  id            String        @id @default(cuid())
  clientId      String?
  contractId    String?
  name          String
  type          ProjectType
  status        ProjectStatus @default(PLANEJADO)
  budgetValue   Float? // valor orçado
  estimatedCost Float?
  hourlyRate    Float? // usado para custo real = horas * hourlyRate
  startDate     DateTime?
  deadline      DateTime?
  responsibleId String?
  costCenterId  String?
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  client           Client?          @relation(fields: [clientId], references: [id])
  contract         Contract?        @relation(fields: [contractId], references: [id])
  responsible      User?            @relation("ProjectResponsible", fields: [responsibleId], references: [id])
  costCenter       CostCenter?      @relation(fields: [costCenterId], references: [id])
  timesheets       Timesheet[]
  financialEntries FinancialEntry[]
  tasks            Task[]           @relation("ProjectTasks")

  @@index([status])
  @@index([type])
  @@index([responsibleId])
}

model Timesheet {
  id          String        @id @default(cuid())
  userId      String
  projectId   String
  date        DateTime
  hours       Float
  description String?
  type        TimesheetType @default(DESENVOLVIMENTO)
  productive  Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([date])
}

// ─────────────────────────────── MARKETING ───────────────────────────────

model MarketingCampaign {
  id                String          @id @default(cuid())
  name              String
  channel           CampaignChannel
  objective         String?
  budget            Float?
  actualSpend       Float?
  leadsGenerated    Int             @default(0)
  clientsGenerated  Int             @default(0)
  attributedRevenue Float?
  startDate         DateTime?
  endDate           DateTime?
  status            CampaignStatus  @default(PLANEJADA)
  costCenterId      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  costCenter       CostCenter?      @relation(fields: [costCenterId], references: [id])
  leads            Lead[]
  financialEntries FinancialEntry[]
  tasks            Task[]           @relation("CampaignTasks")

  @@index([channel])
  @@index([status])
}

// ─────────────────────────────── JURÍDICO ───────────────────────────────

model LegalContract {
  id                   String              @id @default(cuid())
  title                String
  counterpartyName     String?
  counterpartyDocument String?
  supplierName         String?
  clientId             String?
  type                 LegalContractType
  status               LegalContractStatus @default(RASCUNHO)
  startDate            DateTime?
  endDate              DateTime?
  signatureDate        DateTime?
  signedAt             DateTime?
  renewalDate          DateTime?
  expirationDate       DateTime?
  contractValue        Float?
  monthlyValue         Float?
  responsibleId        String?
  costCenterId         String?
  fileUrl              String?
  externalLink         String?
  riskLevel            RiskLevel           @default(BAIXO)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  client      Client?         @relation(fields: [clientId], references: [id])
  responsible User?           @relation("LegalResponsible", fields: [responsibleId], references: [id])
  costCenter  CostCenter?     @relation(fields: [costCenterId], references: [id])
  deadlines   LegalDeadline[]
  documents   LegalDocument[]
  demands     LegalDemand[]   @relation("ContractDemands")
  tasks       Task[]          @relation("LegalTasks")

  @@index([status])
  @@index([type])
  @@index([riskLevel])
}

model LegalDeadline {
  id              String              @id @default(cuid())
  title           String
  description     String?
  legalContractId String?
  legalDemandId   String?
  date            DateTime
  priority        Priority            @default(MEDIA)
  status          LegalDeadlineStatus @default(PENDENTE)
  responsibleId   String?
  costCenterId    String?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  legalContract LegalContract? @relation(fields: [legalContractId], references: [id])
  legalDemand   LegalDemand?   @relation(fields: [legalDemandId], references: [id])
  responsible   User?          @relation("DeadlineResponsible", fields: [responsibleId], references: [id])
  costCenter    CostCenter?    @relation(fields: [costCenterId], references: [id])

  @@index([status])
  @@index([date])
}

model LegalDocument {
  id              String              @id @default(cuid())
  title           String
  type            LegalDocumentType
  status          LegalDocumentStatus @default(RASCUNHO)
  legalContractId String?
  clientId        String?
  fileUrl         String?
  externalLink    String?
  expirationDate  DateTime?
  responsibleId   String?
  costCenterId    String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  legalContract LegalContract? @relation(fields: [legalContractId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  responsible   User?          @relation("LegalDocResponsible", fields: [responsibleId], references: [id])
  costCenter    CostCenter?    @relation(fields: [costCenterId], references: [id])

  @@index([status])
  @@index([type])
}

model LegalDemand {
  id              String            @id @default(cuid())
  title           String
  description     String?
  type            LegalDemandType
  status          LegalDemandStatus @default(ABERTA)
  priority        Priority          @default(MEDIA)
  clientId        String?
  legalContractId String?
  responsibleId   String?
  costCenterId    String?
  openedAt        DateTime          @default(now())
  resolvedAt      DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  client        Client?         @relation(fields: [clientId], references: [id])
  legalContract LegalContract?  @relation("ContractDemands", fields: [legalContractId], references: [id])
  responsible   User?           @relation("LegalDemandResponsible", fields: [responsibleId], references: [id])
  costCenter    CostCenter?     @relation(fields: [costCenterId], references: [id])
  deadlines     LegalDeadline[]

  @@index([status])
  @@index([type])
}

model LegalRisk {
  id                String          @id @default(cuid())
  title             String
  description       String?
  type              LegalRiskType
  probability       RiskScale       @default(MEDIO)
  impact            RiskScale       @default(MEDIO)
  riskLevel         RiskLevel       @default(MEDIO)
  mitigationPlan    String?
  status            LegalRiskStatus @default(ABERTO)
  responsibleId     String?
  costCenterId      String?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  responsible User?       @relation("LegalRiskResponsible", fields: [responsibleId], references: [id])
  costCenter  CostCenter? @relation(fields: [costCenterId], references: [id])

  @@index([status])
  @@index([riskLevel])
}

// ─────────────────────────────── METAS ───────────────────────────────

model Goal {
  id                      String              @id @default(cuid())
  title                   String
  description             String?
  type                    GoalType
  period                  GoalPeriod
  hierarchyLevel          GoalLevel           @default(AVULSA)
  parentGoalId            String?
  planningPeriodId        String?
  goalIndicatorId         String?
  month                   Int?
  quarter                 Int?
  week                    Int?
  year                    Int
  targetValue             Float               @default(0)
  currentValue            Float               @default(0)
  progressPercentage      Float               @default(0)
  unit                    GoalUnit            @default(REAIS)
  calculationMode         GoalCalculationMode @default(MANUAL)
  includeInParentProgress Boolean             @default(true)
  parentWeight            Float? // peso desta meta na composição do progresso do pai (unidades diferentes)
  responsibleId           String?
  costCenterId            String?
  area                    String?
  status                  GoalStatus          @default(NO_PRAZO)
  startDate               DateTime?
  endDate                 DateTime?
  achievedAt              DateTime?
  exceededAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  deletedAt               DateTime?

  responsible    User?              @relation("GoalResponsible", fields: [responsibleId], references: [id])
  costCenter     CostCenter?        @relation(fields: [costCenterId], references: [id])
  parent         Goal?              @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  children       Goal[]             @relation("GoalHierarchy")
  planningPeriod PlanningPeriod?    @relation(fields: [planningPeriodId], references: [id])
  indicator      GoalIndicator?     @relation(fields: [goalIndicatorId], references: [id])
  assignees      GoalAssignee[]
  contributions  GoalContribution[] @relation("GoalContributions")
  tasks          Task[]             @relation("GoalTasks")

  @@index([type])
  @@index([year, month])
  @@index([costCenterId])
  @@index([parentGoalId])
  @@index([planningPeriodId])
  @@index([hierarchyLevel])
  @@index([status])
}

model GoalAssignee {
  id               String               @id @default(cuid())
  goalId           String
  userId           String
  isPrimary        Boolean              @default(false)
  distributionType GoalDistributionType @default(COMPARTILHADA)
  plannedValue     Float?
  realizedValue    Float?
  percentage       Float?
  note             String?
  createdAt        DateTime             @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation("GoalAssigneeUser", fields: [userId], references: [id])

  @@unique([goalId, userId])
  @@index([goalId])
  @@index([userId])
}

/**
 * Contribuição explícita de uma tarefa/checklist para uma meta.
 * Usada para o caso em que uma tarefa alimenta MAIS DE UMA meta sem duplicidade
 * (a meta primária da tarefa é representada por Task.goalId + campos de contribuição).
 */
model GoalContribution {
  id            String           @id @default(cuid())
  taskId        String
  goalId        String
  unit          ContributionUnit @default(QUANTIDADE)
  plannedValue  Float            @default(0)
  realizedValue Float            @default(0)
  weight        Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  goal Goal @relation("GoalContributions", fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([taskId, goalId])
  @@index([goalId])
  @@index([taskId])
}

/**
 * Indicador personalizado de meta (admin): nome, unidade, fórmula, ícone, categoria.
 * Permite metas além dos tipos nativos (GoalType).
 */
model GoalIndicator {
  id                  String           @id @default(cuid())
  name                String
  unit                ContributionUnit @default(QUANTIDADE)
  customUnit          String?
  category            String?
  icon                String?
  formula             String?
  calculationType     String?
  defaultCostCenterId String?
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  costCenter CostCenter? @relation("IndicatorCostCenter", fields: [defaultCostCenterId], references: [id])
  goals      Goal[]

  @@index([active])
}

// ─────────────────────────────── PLANEJAMENTO ───────────────────────────────

/**
 * Nó da hierarquia de planejamento: Ano → Trimestre → Mês → Semana (→ Dia opcional).
 * startDate/endDate são calculados no fuso America/Sao_Paulo e armazenados como instantes UTC.
 * Semanas são reais do calendário (alinhadas à segunda-feira), recortadas ao mês.
 */
model PlanningPeriod {
  id           String               @id @default(cuid())
  name         String
  type         PlanningPeriodType
  year         Int
  quarter      Int?
  month        Int?
  week         Int?
  date         DateTime?
  startDate    DateTime
  endDate      DateTime
  isWorkingDay Boolean              @default(true)
  status       PlanningPeriodStatus @default(PLANEJADO)
  parentId     String?
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  parent    PlanningPeriod?  @relation("PlanningPeriodHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  PlanningPeriod[] @relation("PlanningPeriodHierarchy")
  createdBy User?            @relation("PlanningPeriodCreatedBy", fields: [createdById], references: [id])
  goals     Goal[]
  tasks     Task[]

  @@index([type])
  @@index([year])
  @@index([parentId])
  @@index([startDate, endDate])
}

/**
 * Feriado / dia não útil (nacional cadastrado ou marcação manual).
 */
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  national  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([date])
}

// ─────────────────────────────── TAREFAS ───────────────────────────────

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  assigneeId     String?
  costCenterId   String?
  priority       Priority   @default(MEDIA)
  status         TaskStatus @default(A_FAZER)
  dueDate        DateTime?
  completedAt    DateTime?
  module         ModuleKey? @default(GERAL)
  entityType     String?
  entityId       String?
  estimatedHours Float?
  actualHours    Float?
  recurrence     String?
  tags           String[]   @default([])
  notes          String?
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  // Checklist / contribuição para meta (alimenta o progresso da meta vinculada)
  planningPeriodId     String?
  contributionUnit     ContributionUnit?
  plannedContribution  Float?
  realizedContribution Float?
  contributionWeight   Float?
  evidenceUrl          String?
  evidenceNote         String?

  // Vínculos polimórficos opcionais
  leadId           String?
  clientId         String?
  contractId       String?
  projectId        String?
  campaignId       String?
  goalId           String?
  legalContractId  String?
  financialEntryId String?

  assignee          User?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy         User?              @relation("TaskCreatedBy", fields: [createdById], references: [id])
  costCenter        CostCenter?        @relation(fields: [costCenterId], references: [id])
  planningPeriod    PlanningPeriod?    @relation(fields: [planningPeriodId], references: [id])
  lead              Lead?              @relation("LeadTasks", fields: [leadId], references: [id])
  client            Client?            @relation("ClientTasks", fields: [clientId], references: [id])
  contract          Contract?          @relation("ContractTasks", fields: [contractId], references: [id])
  project           Project?           @relation("ProjectTasks", fields: [projectId], references: [id])
  campaign          MarketingCampaign? @relation("CampaignTasks", fields: [campaignId], references: [id])
  goal              Goal?              @relation("GoalTasks", fields: [goalId], references: [id])
  goalContributions GoalContribution[]
  legalContract     LegalContract?     @relation("LegalTasks", fields: [legalContractId], references: [id])
  financialEntry    FinancialEntry?    @relation("FinancialTasks", fields: [financialEntryId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([module])
  @@index([costCenterId])
  @@index([planningPeriodId])
  @@index([goalId])
}

// ─────────────────────────────── AUDITORIA ───────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json? // { before, after, reason, origin, ... }
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

// Contadores persistentes de tentativas de login. A chave é um HMAC e não
// armazena e-mail ou IP em texto puro.
model LoginThrottle {
  key             String    @id
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

// ─────────────────────────────── FINANCEIRO (cadastros e controle) ───────────────────────────────

/**
 * Fornecedor (contas a pagar). Não confundir com Client (comercial).
 */
model Supplier {
  id        String    @id @default(cuid())
  name      String
  document  String?
  email     String?
  phone     String?
  notes     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  financialEntries FinancialEntry[]
  recurringEntries RecurringEntry[]

  @@index([active])
}

/**
 * Conta bancária / caixa (saldo e fluxo de caixa).
 */
model BankAccount {
  id             String          @id @default(cuid())
  name           String
  bank           String?
  agency         String?
  number         String?
  type           BankAccountType @default(CORRENTE)
  initialBalance Float           @default(0)
  active         Boolean         @default(true)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  financialEntries FinancialEntry[]
  reconciliations  Reconciliation[]

  @@index([active])
}

/**
 * Modelo de recorrência: gera lançamentos financeiros periódicos.
 */
model RecurringEntry {
  id                 String             @id @default(cuid())
  description        String
  type               FinancialType
  value              Float              @default(0)
  frequency          RecurringFrequency @default(MENSAL)
  dayOfMonth         Int                @default(1)
  startDate          DateTime
  endDate            DateTime?
  active             Boolean            @default(true)
  categoryId         String?
  costCenterId       String?
  clientId           String?
  contractId         String?
  supplierId         String?
  lastGeneratedYear  Int?
  lastGeneratedMonth Int?
  notes              String?
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  category         FinancialCategory? @relation(fields: [categoryId], references: [id])
  costCenter       CostCenter?        @relation(fields: [costCenterId], references: [id])
  client           Client?            @relation(fields: [clientId], references: [id])
  contract         Contract?          @relation(fields: [contractId], references: [id])
  supplier         Supplier?          @relation(fields: [supplierId], references: [id])
  createdBy        User?              @relation("RecurringCreatedBy", fields: [createdById], references: [id])
  generatedEntries FinancialEntry[]

  @@index([active])
  @@index([type])
  @@index([contractId])
}

/**
 * Fechamento mensal (bloqueia edições; reabertura auditada).
 */
model MonthlyClosing {
  id           String               @id @default(cuid())
  month        Int
  year         Int
  status       MonthlyClosingStatus @default(ABERTO)
  checklist    Json? // itens do checklist de fechamento
  notes        String?
  closedById   String?
  closedAt     DateTime?
  reopenedById String?
  reopenedAt   DateTime?
  reopenReason String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  closedBy   User? @relation("ClosingClosedBy", fields: [closedById], references: [id])
  reopenedBy User? @relation("ClosingReopenedBy", fields: [reopenedById], references: [id])

  @@unique([year, month])
  @@index([status])
}

/**
 * Anexo/comprovante polimórfico (metadados; o arquivo fica em storage externo).
 */
model Attachment {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  fileName     String
  fileUrl      String
  mimeType     String?
  size         Int?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
}

/**
 * Conciliação bancária (base para integração futura).
 */
model Reconciliation {
  id               String   @id @default(cuid())
  bankAccountId    String
  refDate          DateTime
  statementBalance Float
  systemBalance    Float
  difference       Float    @default(0)
  reconciled       Boolean  @default(false)
  notes            String?
  reconciledById   String?
  createdAt        DateTime @default(now())

  bankAccount  BankAccount @relation(fields: [bankAccountId], references: [id])
  reconciledBy User?       @relation("ReconciledBy", fields: [reconciledById], references: [id])

  @@index([bankAccountId])
}

/**
 * Regra configurável de aprovação de despesa (sem hard-code no código).
 */
model ApprovalRule {
  id                 String   @id @default(cuid())
  name               String
  minAmount          Float    @default(0)
  maxAmount          Float?
  costCenterId       String?
  categoryId         String?
  requiresUnbudgeted Boolean  @default(false) // aplica-se a despesa não orçada
  approverRole       Role?
  requiresPartner    Boolean  @default(false) // exige aprovação de sócio
  active             Boolean  @default(true)
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  costCenter CostCenter?        @relation("ApprovalRuleCostCenter", fields: [costCenterId], references: [id])
  category   FinancialCategory? @relation("ApprovalRuleCategory", fields: [categoryId], references: [id])

  @@index([active])
}

/**
 * Configuração da organização: marca exibida vs. dados jurídicos (singleton).
 */
model OrganizationSettings {
  id          String   @id @default(cuid())
  brandName   String   @default("Telun")
  legalName   String?
  tradeName   String?
  cnpj        String?
  email       String?
  phone       String?
  address     String?
  logoUrl     String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("OrgSettingsUpdatedBy", fields: [updatedById], references: [id])
}
