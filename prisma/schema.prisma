// ─────────────────────────────── CORE ───────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(VIEWER)
  status       UserStatus @default(ATIVO)
  costCenterId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  costCenter             CostCenter?       @relation("UserCostCenter", fields: [costCenterId], references: [id])
  costCentersResponsible CostCenter[]      @relation("CostCenterResponsible")
  leads                  Lead[]            @relation("LeadResponsible")
  leadInteractions       LeadInteraction[]
  clients                Client[]          @relation("ClientResponsible")
  projects               Project[]         @relation("ProjectResponsible")
  timesheets             Timesheet[]
  legalContracts         LegalContract[]   @relation("LegalResponsible")
  legalDeadlines         LegalDeadline[]   @relation("DeadlineResponsible")
  legalDocuments         LegalDocument[]   @relation("LegalDocResponsible")
  legalDemands           LegalDemand[]     @relation("LegalDemandResponsible")
  legalRisks             LegalRisk[]       @relation("LegalRiskResponsible")
  goals                  Goal[]            @relation("GoalResponsible")
  goalAssignments        GoalAssignee[]    @relation("GoalAssigneeUser")
  planningPeriodsCreated PlanningPeriod[]  @relation("PlanningPeriodCreatedBy")
  tasksAssigned          Task[]            @relation("TaskAssignee")
  tasksCreated           Task[]            @relation("TaskCreatedBy")
  budgetsApproved        Budget[]          @relation("BudgetApprover")
  approvalsRequested     ApprovalRequest[] @relation("ApprovalRequester")
  approvalsResponded     ApprovalRequest[] @relation("ApprovalApprover")
  auditLogs              AuditLog[]

  financialCreated          FinancialEntry[]           @relation("FinancialCreatedBy")
  financialResponsible      FinancialEntry[]           @relation("FinancialResponsible")
  financialApproved         FinancialEntry[]           @relation("FinancialApprovedBy")
  recurringCreated          RecurringEntry[]           @relation("RecurringCreatedBy")
  recurringResponsible      RecurringEntry[]           @relation("RecurringResponsible")
  recurringUpdated          RecurringEntry[]           @relation("RecurringUpdatedBy")
  recurringHistory          RecurringEntryHistory[]
  projectionsCreated        FinancialProjection[]      @relation("ProjectionCreatedBy")
  projectionsOwned          FinancialProjection[]      @relation("ProjectionResponsible")
  projectionValues          FinancialProjectionValue[] @relation("ProjectionValueUpdatedBy")
  projectionHistory         ProjectionValueHistory[]
  dreModelsCreated          DreModel[]                 @relation("DreModelCreatedBy")
  dreVersionsPublished      DreModelVersion[]          @relation("DreVersionPublishedBy")
  bankAccountsOwned         BankAccount[]              @relation("BankAccountResponsible")
  suppliersOwned            Supplier[]                 @relation("SupplierResponsible")
  paymentMethodsCreated     PaymentMethodConfig[]      @relation("PaymentMethodCreatedBy")
  financialProductsCreated  FinancialProduct[]         @relation("FinancialProductCreatedBy")
  contractsFinancialOwned   Contract[]                 @relation("ContractFinancialResponsible")
  contractsLegalOwned       Contract[]                 @relation("ContractLegalResponsible")
  contractsCommercialOwned  Contract[]                 @relation("ContractCommercialResponsible")
  contractsCreated          Contract[]                 @relation("ContractCreatedBy")
  contractsUpdated          Contract[]                 @relation("ContractUpdatedBy")
  closingsClosed            MonthlyClosing[]           @relation("ClosingClosedBy")
  closingsReopened          MonthlyClosing[]           @relation("ClosingReopenedBy")
  documentsUploaded         Document[]                 @relation("DocumentUploadedBy")
  documentsUpdated          Document[]                 @relation("DocumentUpdatedBy")
  documentsResponsible      Document[]                 @relation("DocumentResponsible")
  documentVersionsUploaded  DocumentVersion[]          @relation("DocumentVersionUploadedBy")
  documentTypesCreated      DocumentType[]             @relation("DocumentTypeCreatedBy")
  documentCategoriesCreated DocumentCategory[]         @relation("DocumentCategoryCreatedBy")
  documentTagsCreated       DocumentTag[]              @relation("DocumentTagCreatedBy")
  reconciliations           Reconciliation[]           @relation("ReconciledBy")
  orgSettingsUpdated        OrganizationSettings[]     @relation("OrgSettingsUpdatedBy")
  calendarEventsCreated     CalendarEvent[]            @relation("CalendarEventCreatedBy")
  calendarEventsResponsible CalendarEvent[]            @relation("CalendarEventResponsible")
  calendarEventsUpdated     CalendarEvent[]            @relation("CalendarEventUpdatedBy")
  calendarParticipants      CalendarEventParticipant[]
  calendarIntegration       CalendarIntegration?
  googleOAuthStates         GoogleOAuthState[]
  calendarConflictsResolved CalendarSyncConflict[]     @relation("CalendarConflictResolvedBy")
  calendarHistory           CalendarEventHistory[]
  calendarEventTypesCreated CalendarEventTypeConfig[]
  processesOwned            ProcessDefinition[]        @relation("ProcessOwner")
  processReviews            ProcessReview[]            @relation("ProcessReviewedBy")
  correctiveActionsOwned    CorrectiveAction[]         @relation("CorrectiveActionOwner")
  correctiveActionsCreated  CorrectiveAction[]         @relation("CorrectiveActionCreatedBy")
  agentTasksCreated         AgentTask[]                @relation("AgentTaskCreatedBy")
  agentConversations        AgentConversation[]        @relation("AgentConversationUser")
  agentActivityLogs         AgentActivityLog[]         @relation("AgentActivityUser")
  agentApprovalsRequested   AgentApproval[]            @relation("AgentApprovalRequestedBy")
  agentApprovalsDecided     AgentApproval[]            @relation("AgentApprovalDecidedBy")

  @@index([role])
  @@index([status])
}

model CostCenter {
  id                   String         @id @default(cuid())
  code                 Int            @unique // 1000, 2000, 3000, 4000, 5000
  name                 String
  description          String?
  type                 CostCenterType @default(OUTRO)
  responsibleUserId    String?
  parentCostCenterId   String?
  active               Boolean        @default(true)
  monthlyBudgetDefault Float?
  annualBudgetDefault  Float?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  responsibleUser     User?                     @relation("CostCenterResponsible", fields: [responsibleUserId], references: [id])
  parent              CostCenter?               @relation("CostCenterHierarchy", fields: [parentCostCenterId], references: [id])
  children            CostCenter[]              @relation("CostCenterHierarchy")
  users               User[]                    @relation("UserCostCenter")
  contracts           Contract[]
  financialEntries    FinancialEntry[]
  financialCategories FinancialCategory[]       @relation("CategoryCostCenter")
  projects            Project[]
  campaigns           MarketingCampaign[]
  proposals           Proposal[]
  goals               Goal[]
  goalIndicators      GoalIndicator[]           @relation("IndicatorCostCenter")
  tasks               Task[]
  budgets             Budget[]
  budgetLines         BudgetLine[]
  legalContracts      LegalContract[]
  legalDeadlines      LegalDeadline[]
  legalDocuments      LegalDocument[]
  legalDemands        LegalDemand[]
  legalRisks          LegalRisk[]
  recurringEntries    RecurringEntry[]
  approvalRules       ApprovalRule[]            @relation("ApprovalRuleCostCenter")
  projectionLines     FinancialProjectionLine[]
  dreMappings         DreRowMapping[]
  suppliersDefault    Supplier[]                @relation("SupplierDefaultCostCenter")
  calendarEvents      CalendarEvent[]
  processes           ProcessDefinition[]
  correctiveActions   CorrectiveAction[]

  @@index([active])
  @@index([type])
}

model FinancialCategory {
  id           String       @id @default(cuid())
  code         String       @unique // "1.1", "2.3"...
  name         String
  type         CategoryType
  costCenterId String?
  parentId     String? // plano de contas hierárquico (grupo → subgrupo → conta)
  dreGroup     DreGroup? // mapeia a conta para a linha da DRE gerencial
  order        Int          @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  costCenter       CostCenter?               @relation("CategoryCostCenter", fields: [costCenterId], references: [id])
  parent           FinancialCategory?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children         FinancialCategory[]       @relation("CategoryHierarchy")
  financialEntries FinancialEntry[]
  contracts        Contract[]
  budgetLines      BudgetLine[]
  recurringEntries RecurringEntry[]
  approvalRules    ApprovalRule[]            @relation("ApprovalRuleCategory")
  projectionLines  FinancialProjectionLine[]
  dreMappings      DreRowMapping[]
  suppliersDefault Supplier[]                @relation("SupplierDefaultCategory")

  @@index([type])
  @@index([parentId])
  @@index([dreGroup])
}

// ─────────────────────────────── ORÇAMENTO ───────────────────────────────

model Budget {
  id             String           @id @default(cuid())
  costCenterId   String
  periodType     BudgetPeriodType
  month          Int?
  quarter        Int?
  year           Int
  plannedRevenue Float            @default(0)
  plannedExpense Float            @default(0)
  plannedProfit  Float            @default(0)
  status         BudgetStatus     @default(RASCUNHO)
  approvedById   String?
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  costCenter CostCenter   @relation(fields: [costCenterId], references: [id])
  approvedBy User?        @relation("BudgetApprover", fields: [approvedById], references: [id])
  lines      BudgetLine[]

  @@index([costCenterId])
  @@index([year, month])
  @@index([status])
}

model BudgetLine {
  id                  String        @id @default(cuid())
  budgetId            String
  costCenterId        String
  financialCategoryId String?
  type                FinancialType
  plannedAmount       Float         @default(0)
  description         String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  budget     Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  costCenter CostCenter         @relation(fields: [costCenterId], references: [id])
  category   FinancialCategory? @relation(fields: [financialCategoryId], references: [id])

  @@index([budgetId])
  @@index([costCenterId])
}

// ─────────────────────────────── APROVAÇÕES ───────────────────────────────

model ApprovalRequest {
  id            String         @id @default(cuid())
  type          ApprovalType
  requestedById String?
  approvedById  String?
  status        ApprovalStatus @default(PENDENTE)
  entityType    String
  entityId      String
  amount        Float?
  reason        String?
  responseNote  String?
  createdAt     DateTime       @default(now())
  respondedAt   DateTime?

  requestedBy User? @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approvedBy  User? @relation("ApprovalApprover", fields: [approvedById], references: [id])

  @@index([status])
  @@index([type])
  @@index([entityType, entityId])
}

// ─────────────────────────────── CRM / LEADS ───────────────────────────────

model Lead {
  id                String     @id @default(cuid())
  name              String
  company           String?
  phone             String?
  email             String?
  origin            LeadOrigin @default(OUTRO)
  channel           String?
  campaignId        String?
  responsibleId     String?
  costCenterId      String?
  status            LeadStatus @default(NOVO)
  nextAction        String?
  nextActionAt      DateTime?
  estimatedValue    Float?
  probability       Int?
  expectedCloseDate DateTime?
  notes             String?
  lossReason        String?
  tags              String[]   @default([])
  convertedClientId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  campaign        MarketingCampaign? @relation(fields: [campaignId], references: [id])
  responsible     User?              @relation("LeadResponsible", fields: [responsibleId], references: [id])
  convertedClient Client?            @relation("LeadConverted", fields: [convertedClientId], references: [id])
  interactions    LeadInteraction[]
  tasks           Task[]             @relation("LeadTasks")

  @@index([status])
  @@index([origin])
  @@index([responsibleId])
  @@index([createdAt])
}

model LeadInteraction {
  id        String              @id @default(cuid())
  leadId    String
  userId    String?
  type      LeadInteractionType @default(NOTA)
  content   String
  createdAt DateTime            @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
}

// ─────────────────────────────── COMERCIAL ───────────────────────────────

model Client {
  id                    String       @id @default(cuid())
  name                  String
  tradeName             String?
  document              String?
  email                 String?
  phone                 String?
  internalResponsibleId String?
  status                ClientStatus @default(PROSPECT)
  origin                LeadOrigin?
  healthScore           Int          @default(50)
  notes                 String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  internalResponsible  User?                      @relation("ClientResponsible", fields: [internalResponsibleId], references: [id])
  contracts            Contract[]
  proposals            Proposal[]
  projects             Project[]
  financialEntries     FinancialEntry[]
  convertedLeads       Lead[]                     @relation("LeadConverted")
  legalContracts       LegalContract[]
  legalDocuments       LegalDocument[]
  legalDemands         LegalDemand[]
  recurringEntries     RecurringEntry[]
  projectionLines      FinancialProjectionLine[]
  tasks                Task[]                     @relation("ClientTasks")
  calendarEvents       CalendarEvent[]
  calendarParticipants CalendarEventParticipant[]

  @@index([status])
  @@index([internalResponsibleId])
}

model Proposal {
  id           String         @id @default(cuid())
  clientId     String?
  leadId       String?
  costCenterId String?
  title        String
  value        Float          @default(0)
  status       ProposalStatus @default(RASCUNHO)
  nextAction   String?
  nextActionAt DateTime?
  probability  Int?
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  client     Client?     @relation(fields: [clientId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])
  contract   Contract?

  @@index([status])
  @@index([clientId])
}

model Contract {
  id                      String              @id @default(cuid())
  clientId                String
  title                   String
  type                    ContractType
  totalValue              Float?
  monthlyValue            Float?
  startDate               DateTime?
  endDate                 DateTime?
  status                  ContractStatus      @default(ATIVO)
  nextAction              String?
  nextActionAt            DateTime?
  costCenterId            String?
  categoryId              String?
  recurringEnabled        Boolean             @default(false)
  recurringFrequency      RecurringFrequency?
  firstDueDate            DateTime?
  installmentCount        Int?
  recurringDurationMonths Int?
  adjustmentRate          Float?
  renewalDate             DateTime?
  financialProductId      String?
  paymentMethodConfigId   String?
  financialResponsibleId  String?
  contractNumber          String?
  proposalId              String?             @unique
  legacyLegalContractId   String?             @unique
  legalResponsibleId      String?
  commercialResponsibleId String?
  signedAt                DateTime?
  autoRenewal             Boolean             @default(false)
  renewalNoticeDays       Int?
  billingMethod           String?
  relevantClauses         String?
  signatories             String?
  archivedAt              DateTime?
  previousContractId      String?
  createdById             String?
  updatedById             String?
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  deletedAt               DateTime?

  client                Client                    @relation(fields: [clientId], references: [id])
  costCenter            CostCenter?               @relation(fields: [costCenterId], references: [id])
  category              FinancialCategory?        @relation(fields: [categoryId], references: [id])
  financialProduct      FinancialProduct?         @relation(fields: [financialProductId], references: [id])
  paymentMethodConfig   PaymentMethodConfig?      @relation(fields: [paymentMethodConfigId], references: [id])
  financialResponsible  User?                     @relation("ContractFinancialResponsible", fields: [financialResponsibleId], references: [id])
  proposal              Proposal?                 @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  legalResponsible      User?                     @relation("ContractLegalResponsible", fields: [legalResponsibleId], references: [id], onDelete: SetNull)
  commercialResponsible User?                     @relation("ContractCommercialResponsible", fields: [commercialResponsibleId], references: [id], onDelete: SetNull)
  createdBy             User?                     @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy             User?                     @relation("ContractUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  previousContract      Contract?                 @relation("ContractRenewalChain", fields: [previousContractId], references: [id], onDelete: SetNull)
  renewals              Contract[]                @relation("ContractRenewalChain")
  legalDeadlines        LegalDeadline[]           @relation("OfficialContractDeadlines")
  legalDemands          LegalDemand[]             @relation("OfficialContractDemands")
  financialEntries      FinancialEntry[]
  projects              Project[]
  recurringEntries      RecurringEntry[]
  projectionLines       FinancialProjectionLine[]
  tasks                 Task[]                    @relation("ContractTasks")

  @@index([status])
  @@index([type])
  @@index([clientId])
  @@index([financialProductId])
  @@index([paymentMethodConfigId])
  @@index([financialResponsibleId])
  @@index([contractNumber])
  @@index([legalResponsibleId])
  @@index([commercialResponsibleId])
  @@index([previousContractId])
  @@index([endDate])
}

// ─────────────────────────────── FINANCEIRO ───────────────────────────────

model FinancialEntry {
  id                    String          @id @default(cuid())
  description           String
  type                  FinancialType
  value                 Float           @default(0) // valor previsto/principal
  paidValue             Float? // valor realizado (pago/recebido, inclui parciais)
  dueDate               DateTime?
  paymentDate           DateTime?
  competenceMonth       Int // 1-12
  competenceYear        Int
  status                FinancialStatus @default(PENDENTE)
  nextAction            String?
  nextActionAt          DateTime?
  costCenterId          String?
  categoryId            String?
  clientId              String?
  contractId            String?
  projectId             String?
  campaignId            String?
  supplierId            String?
  bankAccountId         String?
  recurringEntryId      String?
  paymentMethodConfigId String?
  productId             String?
  recurrenceSequence    Int?
  recurrenceKey         String?
  recurrenceException   Boolean         @default(false)
  originalDueDate       DateTime?
  recurring             Boolean         @default(false)
  installments          Int?
  installmentNumber     Int?
  paymentMethod         PaymentMethod?
  createdById           String?
  responsibleId         String?
  approvedById          String?
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  costCenter          CostCenter?          @relation(fields: [costCenterId], references: [id])
  category            FinancialCategory?   @relation(fields: [categoryId], references: [id])
  client              Client?              @relation(fields: [clientId], references: [id])
  contract            Contract?            @relation(fields: [contractId], references: [id])
  project             Project?             @relation(fields: [projectId], references: [id])
  campaign            MarketingCampaign?   @relation(fields: [campaignId], references: [id])
  supplier            Supplier?            @relation(fields: [supplierId], references: [id])
  bankAccount         BankAccount?         @relation(fields: [bankAccountId], references: [id])
  recurringEntry      RecurringEntry?      @relation("RecurringGeneratedEntries", fields: [recurringEntryId], references: [id])
  primaryForSeries    RecurringEntry?      @relation("RecurringPrimaryEntry")
  paymentMethodConfig PaymentMethodConfig? @relation(fields: [paymentMethodConfigId], references: [id])
  product             FinancialProduct?    @relation(fields: [productId], references: [id])
  createdBy           User?                @relation("FinancialCreatedBy", fields: [createdById], references: [id])
  responsible         User?                @relation("FinancialResponsible", fields: [responsibleId], references: [id])
  approvedBy          User?                @relation("FinancialApprovedBy", fields: [approvedById], references: [id])
  tasks               Task[]               @relation("FinancialTasks")

  @@unique([recurringEntryId, recurrenceSequence])
  @@unique([recurrenceKey])
  @@index([type])
  @@index([status])
  @@index([competenceYear, competenceMonth])
  @@index([dueDate])
  @@index([costCenterId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([bankAccountId])
  @@index([recurringEntryId])
  @@index([paymentMethodConfigId])
  @@index([productId])
}

// ─────────────────────────────── INOVAÇÃO / TI ───────────────────────────────

model Project {
  id            String        @id @default(cuid())
  clientId      String?
  contractId    String?
  name          String
  type          ProjectType
  status        ProjectStatus @default(PLANEJADO)
  budgetValue   Float? // valor orçado
  estimatedCost Float?
  hourlyRate    Float? // usado para custo real = horas * hourlyRate
  startDate     DateTime?
  deadline      DateTime?
  responsibleId String?
  costCenterId  String?
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  client           Client?                   @relation(fields: [clientId], references: [id])
  contract         Contract?                 @relation(fields: [contractId], references: [id])
  responsible      User?                     @relation("ProjectResponsible", fields: [responsibleId], references: [id])
  costCenter       CostCenter?               @relation(fields: [costCenterId], references: [id])
  timesheets       Timesheet[]
  financialEntries FinancialEntry[]
  recurringEntries RecurringEntry[]
  projectionLines  FinancialProjectionLine[]
  tasks            Task[]                    @relation("ProjectTasks")
  calendarEvents   CalendarEvent[]

  @@index([status])
  @@index([type])
  @@index([responsibleId])
}

model Timesheet {
  id          String        @id @default(cuid())
  userId      String
  projectId   String
  date        DateTime
  hours       Float
  description String?
  type        TimesheetType @default(DESENVOLVIMENTO)
  productive  Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([date])
}

// ─────────────────────────────── MARKETING ───────────────────────────────

model MarketingCampaign {
  id                String          @id @default(cuid())
  name              String
  channel           CampaignChannel
  objective         String?
  budget            Float?
  actualSpend       Float?
  leadsGenerated    Int             @default(0)
  clientsGenerated  Int             @default(0)
  attributedRevenue Float?
  startDate         DateTime?
  endDate           DateTime?
  status            CampaignStatus  @default(PLANEJADA)
  costCenterId      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  costCenter       CostCenter?      @relation(fields: [costCenterId], references: [id])
  leads            Lead[]
  financialEntries FinancialEntry[]
  tasks            Task[]           @relation("CampaignTasks")

  @@index([channel])
  @@index([status])
}

// ─────────────────────────────── JURÍDICO ───────────────────────────────

model LegalContract {
  id                   String              @id @default(cuid())
  title                String
  counterpartyName     String?
  counterpartyDocument String?
  supplierName         String?
  clientId             String?
  type                 LegalContractType
  status               LegalContractStatus @default(RASCUNHO)
  startDate            DateTime?
  endDate              DateTime?
  signatureDate        DateTime?
  signedAt             DateTime?
  renewalDate          DateTime?
  expirationDate       DateTime?
  contractValue        Float?
  monthlyValue         Float?
  responsibleId        String?
  costCenterId         String?
  fileUrl              String?
  externalLink         String?
  riskLevel            RiskLevel           @default(BAIXO)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  client      Client?         @relation(fields: [clientId], references: [id])
  responsible User?           @relation("LegalResponsible", fields: [responsibleId], references: [id])
  costCenter  CostCenter?     @relation(fields: [costCenterId], references: [id])
  deadlines   LegalDeadline[]
  documents   LegalDocument[]
  demands     LegalDemand[]   @relation("ContractDemands")
  tasks       Task[]          @relation("LegalTasks")

  @@index([status])
  @@index([type])
  @@index([riskLevel])
}

model LegalDeadline {
  id              String              @id @default(cuid())
  title           String
  description     String?
  legalContractId String?
  contractId      String?
  legalDemandId   String?
  date            DateTime
  priority        Priority            @default(MEDIA)
  status          LegalDeadlineStatus @default(PENDENTE)
  responsibleId   String?
  costCenterId    String?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  legalContract LegalContract? @relation(fields: [legalContractId], references: [id])
  contract      Contract?      @relation("OfficialContractDeadlines", fields: [contractId], references: [id], onDelete: SetNull)
  legalDemand   LegalDemand?   @relation(fields: [legalDemandId], references: [id])
  responsible   User?          @relation("DeadlineResponsible", fields: [responsibleId], references: [id])
  costCenter    CostCenter?    @relation(fields: [costCenterId], references: [id])

  @@index([status])
  @@index([date])
  @@index([contractId])
}

model LegalDocument {
  id              String              @id @default(cuid())
  title           String
  type            LegalDocumentType
  status          LegalDocumentStatus @default(RASCUNHO)
  legalContractId String?
  clientId        String?
  fileUrl         String?
  externalLink    String?
  expirationDate  DateTime?
  responsibleId   String?
  costCenterId    String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  legalContract LegalContract? @relation(fields: [legalContractId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  responsible   User?          @relation("LegalDocResponsible", fields: [responsibleId], references: [id])
  costCenter    CostCenter?    @relation(fields: [costCenterId], references: [id])

  @@index([status])
  @@index([type])
}

model LegalDemand {
  id              String            @id @default(cuid())
  title           String
  description     String?
  type            LegalDemandType
  status          LegalDemandStatus @default(ABERTA)
  priority        Priority          @default(MEDIA)
  clientId        String?
  legalContractId String?
  contractId      String?
  responsibleId   String?
  costCenterId    String?
  openedAt        DateTime          @default(now())
  resolvedAt      DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  client        Client?         @relation(fields: [clientId], references: [id])
  legalContract LegalContract?  @relation("ContractDemands", fields: [legalContractId], references: [id])
  contract      Contract?       @relation("OfficialContractDemands", fields: [contractId], references: [id], onDelete: SetNull)
  responsible   User?           @relation("LegalDemandResponsible", fields: [responsibleId], references: [id])
  costCenter    CostCenter?     @relation(fields: [costCenterId], references: [id])
  deadlines     LegalDeadline[]

  @@index([status])
  @@index([type])
  @@index([contractId])
}

model LegalRisk {
  id                String          @id @default(cuid())
  title             String
  description       String?
  type              LegalRiskType
  probability       RiskScale       @default(MEDIO)
  impact            RiskScale       @default(MEDIO)
  riskLevel         RiskLevel       @default(MEDIO)
  mitigationPlan    String?
  status            LegalRiskStatus @default(ABERTO)
  responsibleId     String?
  costCenterId      String?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  responsible User?       @relation("LegalRiskResponsible", fields: [responsibleId], references: [id])
  costCenter  CostCenter? @relation(fields: [costCenterId], references: [id])

  @@index([status])
  @@index([riskLevel])
}

// ─────────────────────────────── METAS ───────────────────────────────

model Goal {
  id                      String              @id @default(cuid())
  title                   String
  description             String?
  type                    GoalType
  period                  GoalPeriod
  hierarchyLevel          GoalLevel           @default(AVULSA)
  parentGoalId            String?
  planningPeriodId        String?
  goalIndicatorId         String?
  month                   Int?
  quarter                 Int?
  week                    Int?
  year                    Int
  targetValue             Float               @default(0)
  currentValue            Float               @default(0)
  progressPercentage      Float               @default(0)
  unit                    GoalUnit            @default(REAIS)
  calculationMode         GoalCalculationMode @default(MANUAL)
  includeInParentProgress Boolean             @default(true)
  parentWeight            Float? // peso desta meta na composição do progresso do pai (unidades diferentes)
  responsibleId           String?
  costCenterId            String?
  area                    String?
  status                  GoalStatus          @default(NO_PRAZO)
  startDate               DateTime?
  endDate                 DateTime?
  achievedAt              DateTime?
  exceededAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  deletedAt               DateTime?

  responsible    User?              @relation("GoalResponsible", fields: [responsibleId], references: [id])
  costCenter     CostCenter?        @relation(fields: [costCenterId], references: [id])
  parent         Goal?              @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  children       Goal[]             @relation("GoalHierarchy")
  planningPeriod PlanningPeriod?    @relation(fields: [planningPeriodId], references: [id])
  indicator      GoalIndicator?     @relation(fields: [goalIndicatorId], references: [id])
  assignees      GoalAssignee[]
  contributions  GoalContribution[] @relation("GoalContributions")
  tasks          Task[]             @relation("GoalTasks")
  calendarEvents CalendarEvent[]

  @@index([type])
  @@index([year, month])
  @@index([costCenterId])
  @@index([parentGoalId])
  @@index([planningPeriodId])
  @@index([hierarchyLevel])
  @@index([status])
}

model GoalAssignee {
  id               String               @id @default(cuid())
  goalId           String
  userId           String
  isPrimary        Boolean              @default(false)
  distributionType GoalDistributionType @default(COMPARTILHADA)
  plannedValue     Float?
  realizedValue    Float?
  percentage       Float?
  note             String?
  createdAt        DateTime             @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation("GoalAssigneeUser", fields: [userId], references: [id])

  @@unique([goalId, userId])
  @@index([goalId])
  @@index([userId])
}

/**
 * Contribuição explícita de uma tarefa/checklist para uma meta.
 * Usada para o caso em que uma tarefa alimenta MAIS DE UMA meta sem duplicidade
 * (a meta primária da tarefa é representada por Task.goalId + campos de contribuição).
 */
model GoalContribution {
  id            String           @id @default(cuid())
  taskId        String
  goalId        String
  unit          ContributionUnit @default(QUANTIDADE)
  plannedValue  Float            @default(0)
  realizedValue Float            @default(0)
  weight        Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  goal Goal @relation("GoalContributions", fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([taskId, goalId])
  @@index([goalId])
  @@index([taskId])
}

/**
 * Indicador personalizado de meta (admin): nome, unidade, fórmula, ícone, categoria.
 * Permite metas além dos tipos nativos (GoalType).
 */
model GoalIndicator {
  id                  String           @id @default(cuid())
  name                String
  unit                ContributionUnit @default(QUANTIDADE)
  customUnit          String?
  category            String?
  icon                String?
  formula             String?
  calculationType     String?
  defaultCostCenterId String?
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  costCenter CostCenter? @relation("IndicatorCostCenter", fields: [defaultCostCenterId], references: [id])
  goals      Goal[]

  @@index([active])
}

// ─────────────────────────────── PLANEJAMENTO ───────────────────────────────

/**
 * Nó da hierarquia de planejamento: Ano → Trimestre → Mês → Semana (→ Dia opcional).
 * startDate/endDate são calculados no fuso America/Sao_Paulo e armazenados como instantes UTC.
 * Semanas são reais do calendário (alinhadas à segunda-feira), recortadas ao mês.
 */
model PlanningPeriod {
  id           String               @id @default(cuid())
  name         String
  type         PlanningPeriodType
  year         Int
  quarter      Int?
  month        Int?
  week         Int?
  date         DateTime?
  startDate    DateTime
  endDate      DateTime
  isWorkingDay Boolean              @default(true)
  status       PlanningPeriodStatus @default(PLANEJADO)
  parentId     String?
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  parent         PlanningPeriod?  @relation("PlanningPeriodHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       PlanningPeriod[] @relation("PlanningPeriodHierarchy")
  createdBy      User?            @relation("PlanningPeriodCreatedBy", fields: [createdById], references: [id])
  goals          Goal[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([type])
  @@index([year])
  @@index([parentId])
  @@index([startDate, endDate])
}

/**
 * Feriado / dia não útil (nacional cadastrado ou marcação manual).
 */
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  national  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([date])
}

// ─────────────────────────────── TAREFAS ───────────────────────────────

/**
 * Evento canônico do Telun. Integrações externas são ligadas por
 * CalendarExternalMapping, evitando usar o id do Google como chave interna.
 */
model CalendarEvent {
  id                    String              @id @default(cuid())
  tenantId              String              @default("default")
  title                 String
  description           String?
  type                  CalendarEventType   @default(REUNIAO)
  status                CalendarEventStatus @default(AGENDADO)
  priority              CalendarPriority    @default(MEDIA)
  privacy               CalendarPrivacy     @default(INTERNO)
  origin                CalendarOrigin      @default(TELUN)
  startAt               DateTime
  endAt                 DateTime
  allDay                Boolean             @default(false)
  timezone              String              @default("America/Sao_Paulo")
  location              String?
  meetingUrl            String?
  category              String?
  color                 String?
  department            String?
  notes                 String?
  costCenterId          String?
  goalId                String?
  planningPeriodId      String?
  clientId              String?
  supplierId            String?
  projectId             String?
  responsibleId         String?
  createdById           String?
  updatedById           String?
  recurrenceId          String?
  recurrenceInstanceKey String?
  originalStartAt       DateTime?
  parentEventId         String?
  sourceEntityType      String?
  sourceEntityId        String?
  sourceKey             String?
  syncPending           Boolean             @default(false)
  sourceVersion         Int                 @default(1)
  cancelledAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  costCenter       CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  goal             Goal?                      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  planningPeriod   PlanningPeriod?            @relation(fields: [planningPeriodId], references: [id], onDelete: SetNull)
  client           Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplier         Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  project          Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responsible      User?                      @relation("CalendarEventResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  createdBy        User?                      @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?                      @relation("CalendarEventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  recurrence       CalendarRecurrence?        @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  parentEvent      CalendarEvent?             @relation("CalendarEventExceptions", fields: [parentEventId], references: [id])
  exceptions       CalendarEvent[]            @relation("CalendarEventExceptions")
  participants     CalendarEventParticipant[]
  reminders        CalendarEventReminder[]
  externalMappings CalendarExternalMapping[]
  conflicts        CalendarSyncConflict[]
  history          CalendarEventHistory[]

  @@unique([tenantId, recurrenceInstanceKey])
  @@unique([tenantId, sourceKey])
  @@index([tenantId, startAt, endAt])
  @@index([type])
  @@index([status])
  @@index([privacy])
  @@index([costCenterId])
  @@index([goalId])
  @@index([planningPeriodId])
  @@index([clientId])
  @@index([supplierId])
  @@index([projectId])
  @@index([responsibleId])
  @@index([recurrenceId])
  @@index([parentEventId])
  @@index([sourceEntityType, sourceEntityId])
  @@index([deletedAt])
}

model CalendarEventParticipant {
  id         String                  @id @default(cuid())
  eventId    String
  userId     String?
  clientId   String?
  supplierId String?
  name       String?
  email      String?
  kind       CalendarParticipantKind @default(INTERNO)
  role       String                  @default("PARTICIPANTE")
  status     EventParticipantStatus  @default(CONVIDADO)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  event    CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  client   Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplier Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@unique([eventId, email])
  @@index([eventId])
  @@index([userId])
  @@index([clientId])
  @@index([supplierId])
  @@index([email])
}

model CalendarEventReminder {
  id            String               @id @default(cuid())
  eventId       String
  amount        Int
  unit          CalendarReminderUnit @default(MINUTOS)
  minutesBefore Int
  createdAt     DateTime             @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, minutesBefore])
  @@index([eventId])
}

model CalendarRecurrence {
  id        String                      @id @default(cuid())
  tenantId  String                      @default("default")
  frequency CalendarRecurrenceFrequency
  interval  Int                         @default(1)
  rrule     String
  timezone  String                      @default("America/Sao_Paulo")
  weekDays  Int[]                       @default([])
  monthDay  Int?
  endType   CalendarRecurrenceEndType   @default(NUNCA)
  until     DateTime?
  count     Int?
  active    Boolean                     @default(true)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  events CalendarEvent[]

  @@index([tenantId, active])
}

/**
 * Uma integração Google por usuário. Tokens e syncToken usam envelope
 * autenticado AES-256-GCM; nenhum segredo é armazenado em texto puro.
 */
model CalendarIntegration {
  id                    String                    @id @default(cuid())
  tenantId              String                    @default("default")
  userId                String                    @unique
  provider              String                    @default("GOOGLE")
  googleAccountId       String?
  googleEmail           String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  accessTokenExpiresAt  DateTime?
  grantedScopes         String[]                  @default([])
  selectedCalendarId    String?
  selectedCalendarName  String?
  direction             CalendarSyncDirection     @default(BIDIRECIONAL)
  status                CalendarIntegrationStatus @default(DESCONECTADO)
  syncTokenEncrypted    String?
  lastSyncAt            DateTime?
  lastSuccessfulSyncAt  DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  consecutiveFailures   Int                       @default(0)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  disconnectedAt        DateTime?

  mappings  CalendarExternalMapping[]
  conflicts CalendarSyncConflict[]
  channels  CalendarNotificationChannel[]
  jobs      CalendarSyncJob[]
  user      User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([googleEmail])
}

model GoogleOAuthState {
  id                    String    @id @default(cuid())
  stateHash             String    @unique
  userId                String
  redirectPath          String    @default("/dashboard/calendario")
  codeVerifierEncrypted String?
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CalendarExternalMapping {
  id                 String    @id @default(cuid())
  integrationId      String
  eventId            String
  externalCalendarId String
  externalEventId    String
  etag               String?
  iCalUid            String?
  htmlLink           String?
  googleUpdatedAt    DateTime?
  lastSyncedAt       DateTime?
  lastTelunVersion   Int       @default(0)
  deletedExternally  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  integration CalendarIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  event       CalendarEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalCalendarId, externalEventId])
  @@unique([integrationId, eventId])
  @@index([eventId])
  @@index([iCalUid])
}

model CalendarSyncConflict {
  id              String                 @id @default(cuid())
  integrationId   String
  eventId         String
  externalEventId String?
  telunSnapshot   Json
  googleSnapshot  Json
  status          CalendarConflictStatus @default(PENDENTE)
  resolution      Json?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  integration CalendarIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  event       CalendarEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resolvedBy  User?               @relation("CalendarConflictResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([integrationId, status])
  @@index([eventId])
}

model CalendarNotificationChannel {
  id               String                @id @default(cuid())
  integrationId    String
  channelId        String                @unique
  channelTokenHash String
  resourceId       String
  resourceUri      String?
  expiration       DateTime
  status           CalendarChannelStatus @default(ATIVO)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  integration CalendarIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, status, expiration])
  @@index([resourceId])
}

model CalendarSyncJob {
  id               String                @id @default(cuid())
  integrationId    String?
  type             CalendarSyncJobType
  status           CalendarSyncJobStatus @default(PENDENTE)
  idempotencyKey   String                @unique
  payload          Json?
  attempts         Int                   @default(0)
  maxAttempts      Int                   @default(8)
  runAt            DateTime              @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  completedAt      DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  integration CalendarIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([integrationId, status])
}

model CalendarEventHistory {
  id        String         @id @default(cuid())
  eventId   String
  userId    String?
  action    String
  origin    CalendarOrigin @default(TELUN)
  before    Json?
  after     Json?
  createdAt DateTime       @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([userId, createdAt])
}

model CalendarEventTypeConfig {
  id          String   @id @default(cuid())
  tenantId    String   @default("default")
  key         String
  label       String
  color       String
  icon        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@index([tenantId, active, sortOrder])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  assigneeId     String?
  costCenterId   String?
  priority       Priority   @default(MEDIA)
  status         TaskStatus @default(A_FAZER)
  dueDate        DateTime?
  completedAt    DateTime?
  module         ModuleKey? @default(GERAL)
  entityType     String?
  entityId       String?
  estimatedHours Float?
  actualHours    Float?
  recurrence     String?
  tags           String[]   @default([])
  notes          String?
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  // Checklist / contribuição para meta (alimenta o progresso da meta vinculada)
  planningPeriodId     String?
  contributionUnit     ContributionUnit?
  plannedContribution  Float?
  realizedContribution Float?
  contributionWeight   Float?
  evidenceUrl          String?
  evidenceNote         String?

  // Vínculos polimórficos opcionais
  leadId           String?
  clientId         String?
  contractId       String?
  projectId        String?
  campaignId       String?
  goalId           String?
  legalContractId  String?
  financialEntryId String?

  assignee          User?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy         User?              @relation("TaskCreatedBy", fields: [createdById], references: [id])
  costCenter        CostCenter?        @relation(fields: [costCenterId], references: [id])
  planningPeriod    PlanningPeriod?    @relation(fields: [planningPeriodId], references: [id])
  lead              Lead?              @relation("LeadTasks", fields: [leadId], references: [id])
  client            Client?            @relation("ClientTasks", fields: [clientId], references: [id])
  contract          Contract?          @relation("ContractTasks", fields: [contractId], references: [id])
  project           Project?           @relation("ProjectTasks", fields: [projectId], references: [id])
  campaign          MarketingCampaign? @relation("CampaignTasks", fields: [campaignId], references: [id])
  goal              Goal?              @relation("GoalTasks", fields: [goalId], references: [id])
  goalContributions GoalContribution[]
  legalContract     LegalContract?     @relation("LegalTasks", fields: [legalContractId], references: [id])
  financialEntry    FinancialEntry?    @relation("FinancialTasks", fields: [financialEntryId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([module])
  @@index([costCenterId])
  @@index([planningPeriodId])
  @@index([goalId])
}

// ─────────────────────────────── AUDITORIA ───────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json? // { before, after, reason, origin, ... }
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([entity, createdAt])
  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Contadores persistentes de tentativas de login. A chave é um HMAC e não
// armazena e-mail ou IP em texto puro.
model LoginThrottle {
  key             String    @id
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

// ─────────────────────────────── FINANCEIRO (cadastros e controle) ───────────────────────────────

/**
 * Fornecedor (contas a pagar). Não confundir com Client (comercial).
 */
model Supplier {
  id                    String    @id @default(cuid())
  tenantId              String    @default("default")
  name                  String
  legalName             String?
  document              String?
  email                 String?
  phone                 String?
  category              String?
  defaultCategoryId     String?
  defaultCostCenterId   String?
  responsibleId         String?
  bankDetailsMasked     String?
  bankDetailsRestricted Boolean   @default(true)
  notes                 String?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  financialEntries     FinancialEntry[]
  recurringEntries     RecurringEntry[]
  projectionLines      FinancialProjectionLine[]
  defaultCategory      FinancialCategory?         @relation("SupplierDefaultCategory", fields: [defaultCategoryId], references: [id])
  defaultCostCenter    CostCenter?                @relation("SupplierDefaultCostCenter", fields: [defaultCostCenterId], references: [id])
  responsible          User?                      @relation("SupplierResponsible", fields: [responsibleId], references: [id])
  calendarEvents       CalendarEvent[]
  calendarParticipants CalendarEventParticipant[]

  @@index([active])
  @@index([tenantId, active])
  @@index([defaultCategoryId])
  @@index([defaultCostCenterId])
  @@index([responsibleId])
}

/**
 * Conta bancária / caixa (saldo e fluxo de caixa).
 */
model BankAccount {
  id                      String          @id @default(cuid())
  tenantId                String          @default("default")
  name                    String
  bank                    String?
  agency                  String?
  number                  String?
  type                    BankAccountType @default(CORRENTE)
  initialBalance          Float           @default(0)
  initialBalanceDate      DateTime?
  responsibleId           String?
  sensitiveDataRestricted Boolean         @default(true)
  active                  Boolean         @default(true)
  notes                   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  deletedAt               DateTime?

  financialEntries FinancialEntry[]
  reconciliations  Reconciliation[]
  recurringEntries RecurringEntry[]
  paymentMethods   PaymentMethodConfig[]
  responsible      User?                 @relation("BankAccountResponsible", fields: [responsibleId], references: [id])

  @@index([active])
  @@index([tenantId, active])
  @@index([responsibleId])
}

/**
 * Modelo de recorrência: gera lançamentos financeiros periódicos.
 */
model RecurringEntry {
  id                    String                @id @default(cuid())
  tenantId              String                @default("default")
  idempotencyKey        String?               @unique
  primaryEntryId        String?               @unique
  description           String
  type                  FinancialType
  value                 Float                 @default(0)
  frequency             RecurringFrequency    @default(MENSAL)
  dayOfMonth            Int                   @default(1)
  startDate             DateTime
  endDate               DateTime?
  status                RecurringSeriesStatus @default(ATIVA)
  active                Boolean               @default(true)
  totalOccurrences      Int?
  generatedOccurrences  Int                   @default(0)
  durationMonths        Int?
  nextGenerationDate    DateTime?
  startCompetenceMonth  Int?
  startCompetenceYear   Int?
  categoryId            String?
  costCenterId          String?
  clientId              String?
  contractId            String?
  supplierId            String?
  projectId             String?
  productId             String?
  bankAccountId         String?
  paymentMethod         PaymentMethod?
  paymentMethodConfigId String?
  responsibleId         String?
  lastGeneratedYear     Int?
  lastGeneratedMonth    Int?
  notes                 String?
  createdById           String?
  updatedById           String?
  version               Int                   @default(1)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?

  category            FinancialCategory?      @relation(fields: [categoryId], references: [id])
  costCenter          CostCenter?             @relation(fields: [costCenterId], references: [id])
  client              Client?                 @relation(fields: [clientId], references: [id])
  contract            Contract?               @relation(fields: [contractId], references: [id])
  supplier            Supplier?               @relation(fields: [supplierId], references: [id])
  project             Project?                @relation(fields: [projectId], references: [id])
  product             FinancialProduct?       @relation(fields: [productId], references: [id])
  bankAccount         BankAccount?            @relation(fields: [bankAccountId], references: [id])
  paymentMethodConfig PaymentMethodConfig?    @relation(fields: [paymentMethodConfigId], references: [id])
  responsible         User?                   @relation("RecurringResponsible", fields: [responsibleId], references: [id])
  createdBy           User?                   @relation("RecurringCreatedBy", fields: [createdById], references: [id])
  updatedBy           User?                   @relation("RecurringUpdatedBy", fields: [updatedById], references: [id])
  primaryEntry        FinancialEntry?         @relation("RecurringPrimaryEntry", fields: [primaryEntryId], references: [id])
  generatedEntries    FinancialEntry[]        @relation("RecurringGeneratedEntries")
  history             RecurringEntryHistory[]

  @@index([active])
  @@index([tenantId, status])
  @@index([type])
  @@index([contractId])
  @@index([projectId])
  @@index([productId])
  @@index([responsibleId])
}

/**
 * Histórico imutável de alterações/cancelamentos de uma série recorrente.
 */
model RecurringEntryHistory {
  id               String   @id @default(cuid())
  recurringEntryId String
  userId           String?
  action           String
  scope            String
  occurrenceNumber Int?
  reason           String?
  before           Json?
  after            Json?
  createdAt        DateTime @default(now())

  recurringEntry RecurringEntry @relation(fields: [recurringEntryId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id])

  @@index([recurringEntryId, createdAt])
  @@index([userId, createdAt])
}

/**
 * Forma de pagamento administrável. Complementa o enum legado sem quebrar
 * lançamentos existentes.
 */
model PaymentMethodConfig {
  id             String    @id @default(cuid())
  tenantId       String    @default("default")
  code           String
  name           String
  settlementDays Int       @default(0)
  feeRate        Float     @default(0)
  bankAccountId  String?
  active         Boolean   @default(true)
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  bankAccount      BankAccount?     @relation(fields: [bankAccountId], references: [id])
  createdBy        User?            @relation("PaymentMethodCreatedBy", fields: [createdById], references: [id])
  financialEntries FinancialEntry[]
  recurringEntries RecurringEntry[]
  contracts        Contract[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@index([bankAccountId])
}

model FinancialProduct {
  id          String               @id @default(cuid())
  tenantId    String               @default("default")
  code        String
  name        String
  type        FinancialProductType @default(SERVICO)
  active      Boolean              @default(true)
  notes       String?
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  createdBy        User?                     @relation("FinancialProductCreatedBy", fields: [createdById], references: [id])
  financialEntries FinancialEntry[]
  recurringEntries RecurringEntry[]
  projectionLines  FinancialProjectionLine[]
  contracts        Contract[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model FinancialProjection {
  id                 String                 @id @default(cuid())
  tenantId           String                 @default("default")
  name               String
  description        String?
  year               Int
  periodStartMonth   Int                    @default(1)
  periodEndMonth     Int                    @default(12)
  scenarioType       ProjectionScenarioType @default(PERSONALIZADO)
  status             ProjectionStatus       @default(RASCUNHO)
  version            Int                    @default(1)
  responsibleId      String?
  createdById        String?
  sourceProjectionId String?
  sourceKind         String?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  archivedAt         DateTime?

  responsible      User?                     @relation("ProjectionResponsible", fields: [responsibleId], references: [id])
  createdBy        User?                     @relation("ProjectionCreatedBy", fields: [createdById], references: [id])
  sourceProjection FinancialProjection?      @relation("ProjectionCopies", fields: [sourceProjectionId], references: [id])
  copies           FinancialProjection[]     @relation("ProjectionCopies")
  lines            FinancialProjectionLine[]

  @@unique([tenantId, name, year, version])
  @@index([tenantId, year, status])
  @@index([responsibleId])
}

model FinancialProjectionLine {
  id              String             @id @default(cuid())
  projectionId    String
  label           String
  type            ProjectionLineType
  order           Int                @default(0)
  categoryId      String?
  costCenterId    String?
  projectId       String?
  productId       String?
  clientId        String?
  supplierId      String?
  contractId      String?
  automaticSource String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  projection FinancialProjection        @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  category   FinancialCategory?         @relation(fields: [categoryId], references: [id])
  costCenter CostCenter?                @relation(fields: [costCenterId], references: [id])
  project    Project?                   @relation(fields: [projectId], references: [id])
  product    FinancialProduct?          @relation(fields: [productId], references: [id])
  client     Client?                    @relation(fields: [clientId], references: [id])
  supplier   Supplier?                  @relation(fields: [supplierId], references: [id])
  contract   Contract?                  @relation(fields: [contractId], references: [id])
  values     FinancialProjectionValue[]

  @@index([projectionId, order])
  @@index([categoryId])
  @@index([costCenterId])
}

model FinancialProjectionValue {
  id             String                @id @default(cuid())
  lineId         String
  month          Int
  automaticValue Float                 @default(0)
  manualValue    Float?
  realizedValue  Float?
  source         ProjectionValueSource @default(AUTOMATICO)
  notes          String?
  updatedById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  line      FinancialProjectionLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  updatedBy User?                    @relation("ProjectionValueUpdatedBy", fields: [updatedById], references: [id])
  history   ProjectionValueHistory[]

  @@unique([lineId, month])
  @@index([updatedById])
}

model ProjectionValueHistory {
  id                String                 @id @default(cuid())
  projectionValueId String
  userId            String?
  previousValue     Float?
  newValue          Float?
  previousSource    ProjectionValueSource?
  newSource         ProjectionValueSource
  reason            String?
  createdAt         DateTime               @default(now())

  projectionValue FinancialProjectionValue @relation(fields: [projectionValueId], references: [id], onDelete: Cascade)
  user            User?                    @relation(fields: [userId], references: [id])

  @@index([projectionValueId, createdAt])
  @@index([userId, createdAt])
}

model DreModel {
  id             String         @id @default(cuid())
  tenantId       String         @default("default")
  name           String
  description    String?
  status         DreModelStatus @default(RASCUNHO)
  isDefault      Boolean        @default(false)
  currentVersion Int            @default(1)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?

  createdBy User?             @relation("DreModelCreatedBy", fields: [createdById], references: [id])
  versions  DreModelVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, isDefault])
}

model DreModelVersion {
  id            String         @id @default(cuid())
  modelId       String
  version       Int
  status        DreModelStatus @default(RASCUNHO)
  effectiveFrom DateTime?
  publishedById String?
  publishedAt   DateTime?
  notes         String?
  createdAt     DateTime       @default(now())

  model       DreModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  publishedBy User?    @relation("DreVersionPublishedBy", fields: [publishedById], references: [id])
  rows        DreRow[]

  @@unique([modelId, version])
  @@index([status, effectiveFrom])
}

model DreRow {
  id        String     @id @default(cuid())
  versionId String
  parentId  String?
  code      String
  name      String
  kind      DreRowKind @default(CONTA)
  order     Int        @default(0)
  sign      Int        @default(1)
  hidden    Boolean    @default(false)
  formula   Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  version  DreModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parent   DreRow?         @relation("DreRowHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children DreRow[]        @relation("DreRowHierarchy")
  mappings DreRowMapping[]

  @@unique([versionId, code])
  @@index([versionId, order])
  @@index([parentId])
}

model DreRowMapping {
  id                 String  @id @default(cuid())
  rowId              String
  categoryId         String?
  costCenterId       String?
  includeDescendants Boolean @default(true)

  row        DreRow             @relation(fields: [rowId], references: [id], onDelete: Cascade)
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])
  costCenter CostCenter?        @relation(fields: [costCenterId], references: [id])

  @@index([rowId])
  @@index([categoryId])
  @@index([costCenterId])
}

/**
 * Fechamento mensal (bloqueia edições; reabertura auditada).
 */
model MonthlyClosing {
  id           String               @id @default(cuid())
  month        Int
  year         Int
  status       MonthlyClosingStatus @default(ABERTO)
  checklist    Json? // itens do checklist de fechamento
  notes        String?
  closedById   String?
  closedAt     DateTime?
  reopenedById String?
  reopenedAt   DateTime?
  reopenReason String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  closedBy   User? @relation("ClosingClosedBy", fields: [closedById], references: [id])
  reopenedBy User? @relation("ClosingReopenedBy", fields: [reopenedById], references: [id])

  @@unique([year, month])
  @@index([status])
}

/**
 * Documento canônico do Telun. Mantém o mapeamento para a tabela histórica
 * Attachment para preservar anexos existentes sem criar um cadastro paralelo.
 * `fileUrl` guarda somente uma chave opaca no storage privado.
 */
model Document {
  id             String          @id @default(cuid())
  tenantId       String          @default("default")
  entityType     String
  entityId       String
  fileName       String
  fileUrl        String
  originalName   String          @default("")
  extension      String          @default("")
  sha256         String          @default("")
  mimeType       String?
  size           Int?
  externalUrl    String?
  description    String?
  documentTypeId String?
  categoryId     String?
  status         DocumentStatus  @default(ATIVO)
  privacy        DocumentPrivacy @default(INTERNO)
  documentDate   DateTime?
  validFrom      DateTime?
  expirationDate DateTime?
  responsibleId  String?
  uploadedById   String?
  updatedById    String?
  currentVersion Int             @default(1)
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  documentType DocumentType?             @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  category     DocumentCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  responsible  User?                     @relation("DocumentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  uploadedBy   User?                     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  updatedBy    User?                     @relation("DocumentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versions     DocumentVersion[]
  links        DocumentLink[]
  tags         DocumentTagLink[]
  alerts       DocumentExpirationAlert[]

  @@index([tenantId, deletedAt, createdAt])
  @@index([entityType, entityId])
  @@index([documentTypeId])
  @@index([categoryId])
  @@index([responsibleId])
  @@index([status])
  @@index([privacy])
  @@index([expirationDate])
  @@map("Attachment")
}

model DocumentVersion {
  id           String                @id @default(cuid())
  documentId   String
  version      Int
  fileUrl      String
  originalName String
  extension    String
  mimeType     String
  size         Int
  sha256       String
  uploadedById String?
  note         String?
  reason       String?
  status       DocumentVersionStatus @default(ATUAL)
  createdAt    DateTime              @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([documentId, version])
  @@index([sha256])
  @@index([uploadedById])
}

model DocumentType {
  id                 String   @id @default(cuid())
  tenantId           String   @default("default")
  name               String
  slug               String
  description        String?
  color              String?
  icon               String?
  requiresExpiration Boolean  @default(false)
  requiresContract   Boolean  @default(false)
  requiresSignature  Boolean  @default(false)
  requiredFields     Json?
  active             Boolean  @default(true)
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy User?      @relation("DocumentTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents Document[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
}

model DocumentCategory {
  id          String   @id @default(cuid())
  tenantId    String   @default("default")
  name        String
  slug        String
  description String?
  color       String?
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?      @relation("DocumentCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents Document[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
}

model DocumentTag {
  id             String   @id @default(cuid())
  tenantId       String   @default("default")
  name           String
  normalizedName String
  color          String?
  createdById    String?
  createdAt      DateTime @default(now())

  createdBy User?             @relation("DocumentTagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents DocumentTagLink[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId, name])
}

model DocumentTagLink {
  documentId String
  tagId      String
  createdAt  DateTime @default(now())

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
}

model DocumentLink {
  id         String   @id @default(cuid())
  documentId String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
}

model DocumentExpirationAlert {
  id              String              @id @default(cuid())
  documentId      String
  daysBefore      Int
  alertDate       DateTime
  status          DocumentAlertStatus @default(PENDENTE)
  sourceKey       String              @unique
  calendarEventId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, daysBefore])
  @@index([alertDate, status])
}

/**
 * Conciliação bancária (base para integração futura).
 */
model Reconciliation {
  id               String   @id @default(cuid())
  bankAccountId    String
  refDate          DateTime
  statementBalance Float
  systemBalance    Float
  difference       Float    @default(0)
  reconciled       Boolean  @default(false)
  notes            String?
  reconciledById   String?
  createdAt        DateTime @default(now())

  bankAccount  BankAccount @relation(fields: [bankAccountId], references: [id])
  reconciledBy User?       @relation("ReconciledBy", fields: [reconciledById], references: [id])

  @@index([bankAccountId])
}

/**
 * Regra configurável de aprovação de despesa (sem hard-code no código).
 */
model ApprovalRule {
  id                 String   @id @default(cuid())
  name               String
  minAmount          Float    @default(0)
  maxAmount          Float?
  costCenterId       String?
  categoryId         String?
  requiresUnbudgeted Boolean  @default(false) // aplica-se a despesa não orçada
  approverRole       Role?
  requiresPartner    Boolean  @default(false) // exige aprovação de sócio
  active             Boolean  @default(true)
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  costCenter CostCenter?        @relation("ApprovalRuleCostCenter", fields: [costCenterId], references: [id])
  category   FinancialCategory? @relation("ApprovalRuleCategory", fields: [categoryId], references: [id])

  @@index([active])
}

/**
 * Configuração da organização: marca exibida vs. dados jurídicos (singleton).
 */
model OrganizationSettings {
  id          String   @id @default(cuid())
  brandName   String   @default("Telun")
  legalName   String?
  tradeName   String?
  cnpj        String?
  email       String?
  phone       String?
  address     String?
  logoUrl     String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("OrgSettingsUpdatedBy", fields: [updatedById], references: [id])
}

// ─────────────────────────── GOVERNANÇA DE PROCESSOS ───────────────────────────
// Camada de ACOMPANHAMENTO dos 12 processos operacionais. A EXECUÇÃO acontece
// nos módulos (Comercial, Financeiro, TI, Marketing, Jurídico). Aqui ficam a
// definição/metadados (§3), as revisões periódicas (§12) e as ações corretivas.

enum ProcessStatus {
  PLANEJADO
  IMPLANTACAO
  ATIVO
  EM_REVISAO
  INATIVO
}

enum ProcessReviewCadence {
  SEMANAL
  QUINZENAL
  MENSAL
  TRIMESTRAL
}

enum ProcessHealth {
  OK
  ATENCAO
  CRITICO
}

enum CorrectiveActionStatus {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/**
 * Definição/metadados de um processo operacional oficial da Telun (§3).
 */
model ProcessDefinition {
  id               String               @id @default(cuid())
  tenantId         String               @default("default")
  code             String // F1, T2, OC3...
  name             String
  costCenterId     String?
  ownerId          String?
  secondaryOwners  String[]             @default([])
  objective        String?
  description      String?
  trigger          String?
  inputs           String?
  steps            String[]             @default([])
  output           String?
  sla              String?
  kpiPrimaryName   String?
  kpiPrimaryTarget String?
  kpiPrimaryUnit   String?
  kpiSource        String? // chave usada pelo app p/ computar o KPI ao vivo (§13)
  kpisSecondary    Json?
  target           String?
  reviewCadence    ProcessReviewCadence @default(SEMANAL)
  status           ProcessStatus        @default(ATIVO)
  version          Int                  @default(1)
  startDate        DateTime?
  lastReviewAt     DateTime?
  nextReviewAt     DateTime?
  documentationUrl String?
  notes            String?
  order            Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  costCenter        CostCenter?        @relation(fields: [costCenterId], references: [id])
  owner             User?              @relation("ProcessOwner", fields: [ownerId], references: [id])
  reviews           ProcessReview[]
  correctiveActions CorrectiveAction[]

  @@unique([tenantId, code])
  @@index([status])
  @@index([costCenterId])
}

/**
 * Revisão periódica de um processo (snapshot de KPIs + decisões) — §12.
 */
model ProcessReview {
  id           String        @id @default(cuid())
  tenantId     String        @default("default")
  processId    String
  reviewedById String?
  reviewDate   DateTime      @default(now())
  periodLabel  String? // ex.: "Semana 32/2026"
  health       ProcessHealth @default(OK)
  kpiSnapshot  Json?
  highlights   String?
  issues       String?
  decisions    String?
  createdAt    DateTime      @default(now())

  process    ProcessDefinition @relation(fields: [processId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("ProcessReviewedBy", fields: [reviewedById], references: [id])

  @@index([processId])
  @@index([reviewDate])
}

/**
 * Ação corretiva originada da revisão semanal (§12).
 */
model CorrectiveAction {
  id           String                 @id @default(cuid())
  tenantId     String                 @default("default")
  title        String
  problem      String?
  costCenterId String?
  processId    String?
  ownerId      String?
  createdById  String?
  action       String?
  priority     Priority               @default(MEDIA)
  status       CorrectiveActionStatus @default(ABERTA)
  dueDate      DateTime?
  resolvedAt   DateTime?
  result       String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  costCenter CostCenter?        @relation(fields: [costCenterId], references: [id])
  process    ProcessDefinition? @relation(fields: [processId], references: [id])
  owner      User?              @relation("CorrectiveActionOwner", fields: [ownerId], references: [id])
  createdBy  User?              @relation("CorrectiveActionCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([processId])
  @@index([costCenterId])
}

// ═══════════════════════ TELUN OFFICE — funcionários digitais (IA) ═══════════════════════
// Camada de agentes de IA dentro do HUB. A AUTORIDADE É SEMPRE DO BACKEND (nunca do prompt):
// permissões de tool, nível de autonomia e aprovações são validadas pelo Agent Engine.
// Tudo aditivo; multi-tenant leve (tenantId "default"). UI leve (sem 3D/engine/loop).

enum AgentStatus {
  OFFLINE
  IDLE
  WORKING
  WAITING
  WAITING_APPROVAL
  ERROR
}

enum AgentTaskStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  WAITING_APPROVAL
}

enum AgentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AgentMessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum AgentMemoryScope {
  SHORT_TERM
  OPERATIONAL
  PERSISTENT
}

enum AgentActivityType {
  MESSAGE
  TOOL_CALL
  TOOL_RESULT
  TOOL_ERROR
  STATUS_CHANGE
  TASK_CREATED
  TASK_STARTED
  TASK_COMPLETED
  TASK_FAILED
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  DECISION
  ERROR
  NOTE
}

enum AgentToolAccess {
  ALLOW
  DENY
}

/// Funcionário digital (identidade, cargo, autonomia, prompt, modelo). Seeds em src/lib/agent-catalog.
model Agent {
  id              String      @id @default(cuid())
  tenantId        String      @default("default")
  slug            String
  name            String
  avatar          String? // emoji/inicial (UI leve)
  role            String // cargo (ex.: "Analista Financeira IA")
  department      String // Financeiro | Comercial | TI / Inovação | Executivo
  description     String?
  objective       String?
  status          AgentStatus @default(OFFLINE)
  currentActivity String? // frase curta do estado atual (dirigida por evento real)
  autonomyLevel   Int         @default(1) // 0..4 — V1 inicia em 1
  aiProvider      String      @default("ollama")
  aiModel         String? // null = usa OLLAMA_MODEL da config central
  systemPrompt    String // identidade + regras comportamentais (segurança real no backend)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tasks           AgentTask[]
  conversations   AgentConversation[]
  activityLogs    AgentActivityLog[]
  approvals       AgentApproval[]
  memories        AgentMemory[]
  toolPermissions AgentToolPermission[]

  @@unique([tenantId, slug])
  @@index([department])
  @@index([status])
  @@index([isActive])
}

model AgentTask {
  id          String          @id @default(cuid())
  tenantId    String          @default("default")
  agentId     String
  title       String
  description String?
  status      AgentTaskStatus @default(PENDING)
  priority    Priority        @default(MEDIA)
  source      String          @default("user") // user | event | agent | system
  createdById String?
  entityType  String? // tipo do registro Telun relacionado (ex.: FinancialEntry)
  entityId    String?
  result      String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation("AgentTaskCreatedBy", fields: [createdById], references: [id])
  approvals    AgentApproval[]
  activityLogs AgentActivityLog[]

  @@index([tenantId])
  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

model AgentConversation {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  agentId   String
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user         User               @relation("AgentConversationUser", fields: [userId], references: [id])
  messages     AgentMessage[]
  activityLogs AgentActivityLog[]
  approvals    AgentApproval[]

  @@index([agentId])
  @@index([userId])
  @@index([createdAt])
}

model AgentMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           AgentMessageRole
  content        String // sem raciocínio interno privado do modelo (§14)
  toolName       String?
  toolCallId     String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model AgentActivityLog {
  id             String            @id @default(cuid())
  tenantId       String            @default("default")
  agentId        String
  taskId         String?
  conversationId String?
  userId         String?
  type           AgentActivityType
  title          String
  description    String?
  metadata       Json?
  createdAt      DateTime          @default(now())

  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task         AgentTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  conversation AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  user         User?              @relation("AgentActivityUser", fields: [userId], references: [id])

  @@index([agentId])
  @@index([taskId])
  @@index([conversationId])
  @@index([type])
  @@index([createdAt])
}

model AgentApproval {
  id             String              @id @default(cuid())
  tenantId       String              @default("default")
  agentId        String
  taskId         String?
  conversationId String?
  requestedById  String? // usuário em cuja sessão o agente atuou
  type           String
  title          String
  description    String?
  proposedAction String
  metadata       Json?
  status         AgentApprovalStatus @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  requestedAt    DateTime            @default(now())

  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task         AgentTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  conversation AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  requestedBy  User?              @relation("AgentApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy    User?              @relation("AgentApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([agentId])
  @@index([status])
  @@index([taskId])
  @@index([requestedAt])
}

model AgentMemory {
  id         String           @id @default(cuid())
  tenantId   String           @default("default")
  agentId    String
  scope      AgentMemoryScope @default(OPERATIONAL)
  entityType String?
  entityId   String?
  content    String
  importance Int              @default(1)
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([scope])
  @@index([expiresAt])
}

/// Ferramenta controlada. A lógica de execução vive no código (registry); esta tabela
/// guarda metadados + habilita permissões por agente. Seeds em src/lib/agent-catalog.
model AgentTool {
  id               String   @id @default(cuid())
  tenantId         String   @default("default")
  slug             String
  name             String
  description      String
  category         String // financeiro | comercial | ti | executivo | shared
  requiresApproval Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  permissions AgentToolPermission[]

  @@unique([tenantId, slug])
  @@index([category])
}

model AgentToolPermission {
  id        String          @id @default(cuid())
  agentId   String
  toolId    String
  access    AgentToolAccess @default(ALLOW)
  createdAt DateTime        @default(now())

  agent Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  AgentTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@index([agentId])
  @@index([toolId])
}
