# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL / Neon)
# Use a connection string do seu projeto Neon. Exemplo:
# postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js v5 (NextAuth) — segredo de assinatura das sessões JWT.
# Gere um novo com:  npx auth secret   (ou)  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="troque-por-um-segredo-forte"

# Senha inicial dos usuários criados pelo seed (prisma/seed.ts).
# Obrigatória, com no mínimo 12 caracteres.
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"

# Domínio institucional dos usuários-semente (opcional; padrão telun.com.br).
# SEED_EMAIL_DOMAIN="telun.com.br"

# Dados fictícios de demonstração (nunca habilite em produção).
# SEED_DEMO_DATA="false"

# URL base da aplicação (opcional em dev; defina em produção).
# AUTH_URL="https://interno.telun.com.br"

# Separação frontend/backend (produção):
# PUBLIC_FRONTEND_URL="https://chronoshub.chronostek.com.br"
# NEXT_PUBLIC_API_BASE_URL="https://api.chronostek.com.br"
# AUTH_URL="https://api.chronostek.com.br"
# AUTH_COOKIE_DOMAIN=".chronostek.com.br"

# Google Calendar OAuth (cliente OAuth 2.0 do tipo Web).
# Cadastre o callback abaixo exatamente no Google Cloud Console.
# GOOGLE_CALENDAR_CLIENT_ID=""
# GOOGLE_CALENDAR_CLIENT_SECRET=""
# GOOGLE_CALENDAR_REDIRECT_URI="https://api.chronostek.com.br/api/integrations/google/calendar/oauth/callback"
# GOOGLE_CALENDAR_WEBHOOK_URL="https://api.chronostek.com.br/api/integrations/google/calendar/webhook"

# Chave de 32 bytes em base64 ou 64 caracteres hex para AES-256-GCM.
# Gere, por exemplo, com: openssl rand -base64 32
# CALENDAR_TOKEN_ENCRYPTION_KEY=""

# Habilite somente quando a aplicação estiver atrás de proxy reverso confiável.
# Permite usar X-Forwarded-For/X-Real-IP no rate limiting do login.
# AUTH_TRUST_PROXY="true"
