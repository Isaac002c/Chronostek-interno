# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL / Neon)
# Use a connection string do seu projeto Neon. Exemplo:
# postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js v5 (NextAuth) — segredo de assinatura das sessões JWT.
# Gere um novo com:  npx auth secret   (ou)  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="troque-por-um-segredo-forte"

# Senha inicial dos usuários criados pelo seed (prisma/seed.ts).
# Obrigatória, com no mínimo 12 caracteres.
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"

# Domínio institucional dos usuários-semente (opcional; padrão telun.com.br).
# SEED_EMAIL_DOMAIN="telun.com.br"

# Dados fictícios de demonstração (nunca habilite em produção).
# SEED_DEMO_DATA="false"

# URL base da aplicação (opcional em dev; defina em produção).
# AUTH_URL="https://interno.telun.com.br"

# Separação frontend/backend (produção):
# PUBLIC_FRONTEND_URL="https://chronoshub.chronostek.com.br"
# NEXT_PUBLIC_API_BASE_URL="https://api.chronostek.com.br"
# AUTH_URL="https://api.chronostek.com.br"
# AUTH_COOKIE_DOMAIN=".chronostek.com.br"

# Google Calendar OAuth (cliente OAuth 2.0 do tipo Web).
# Cadastre o callback abaixo exatamente no Google Cloud Console.
# GOOGLE_CALENDAR_CLIENT_ID=""
# GOOGLE_CALENDAR_CLIENT_SECRET=""
# GOOGLE_CALENDAR_REDIRECT_URI="https://api.chronostek.com.br/api/integrations/google/calendar/oauth/callback"
# GOOGLE_CALENDAR_WEBHOOK_URL="https://api.chronostek.com.br/api/integrations/google/calendar/webhook"

# Chave de 32 bytes em base64 ou 64 caracteres hex para AES-256-GCM.
# Gere, por exemplo, com: openssl rand -base64 32
# CALENDAR_TOKEN_ENCRYPTION_KEY=""

# Habilite somente quando a aplicação estiver atrás de proxy reverso confiável.
# Permite usar X-Forwarded-For/X-Real-IP no rate limiting do login.
# AUTH_TRUST_PROXY="true"

# ---------------------------------------------------------------------------
# TELUN OFFICE — funcionários digitais. Provider padrão da V1: Groq.
# O navegador NUNCA fala com o provider — somente o backend/Agent Engine.
# GROQ_API_KEY é secret exclusivamente server-side; nunca use NEXT_PUBLIC_.
# O Telun Office funciona mesmo com a IA offline (fallback) — só o chat fica
# indisponível até o provider voltar.
# ---------------------------------------------------------------------------
# AI_ENABLED="true"
# AI_PROVIDER="groq"
# GROQ_API_KEY=""
# GROQ_MODEL="qwen/qwen3.6-27b"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# AI_MAX_CONCURRENCY="1"               # inferências simultâneas (conservador)
# AI_REQUEST_TIMEOUT="60000"           # ms
# AI_TEMPERATURE="0.3"
# AI_MAX_TOOL_ROUNDS="5"               # limite rígido de rodadas por turno
# AI_MAX_TOOL_CALLS="10"                # limite total de tools por turno
# AI_HISTORY_LIMIT="12"                 # janela recente da conversa
# AI_MAX_RETRIES="1"                    # somente 5xx; nunca repetir 429

# Provider alternativo futuro (preservado; não habilitar na VPS compartilhada):
# AI_PROVIDER="ollama"
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="qwen2.5:3b-instruct"

# AI Router free-first e circuit breaker (server-side).
# AI_ROUTER_ORDER="groq,gemini,cloudflare,openrouter,ollama"
# AI_MAX_OUTPUT_TOKENS="700"
# AI_CIRCUIT_FAILURE_THRESHOLD="2"
# AI_CIRCUIT_COOLDOWN_MS="60000"
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.6-flash"
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"
# CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-1-schnell"
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="openrouter/free"

# TELUN AUTONOMOUS WORKFORCE
# GLOBAL_AGENT_KILL_SWITCH="false"
# AGENT_WORKER_POLL_MS="2000"
# AGENT_WORKER_HEARTBEAT_FILE="/tmp/telun-agent-worker-heartbeat"
# WORKFORCE_API_TOKEN=""

# Comunicação WhatsApp. O envio automático nasce DESLIGADO.
# EVOLUTION_API_URL=""
# EVOLUTION_API_KEY=""
# EVOLUTION_INSTANCE="telun-comercial"
# EVOLUTION_WEBHOOK_SECRET=""
# AUTO_OUTREACH_ENABLED="false"
# OUTREACH_DAILY_LIMIT="20"
# OUTREACH_HOURLY_LIMIT="5"
# OUTREACH_BUSINESS_HOUR_START="9"
# OUTREACH_BUSINESS_HOUR_END="18"
# OUTREACH_APPROVED_TEMPLATES=""

# InfinitePay. Criar links permanece desligado até a conta habilitar Checkout.
# INFINITEPAY_HANDLE=""
# INFINITEPAY_CREATE_LINKS_ENABLED="false"
# AI_KEEP_ALIVE="5m"                   # tempo que o modelo fica carregado após uso
