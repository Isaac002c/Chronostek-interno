{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node -e \"const fs=require('fs');fs.mkdirSync('vercel-proxy',{recursive:true});fs.writeFileSync('vercel-proxy/healthz.txt','telun-proxy-ok')\"",
  "outputDirectory": "vercel-proxy",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://api-interno.chronostek.com.br/"
    },
    {
      "source": "/:path*",
      "destination": "https://api-interno.chronostek.com.br/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
